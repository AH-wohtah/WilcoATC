<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 = LTS courante. WPF -> suffixe -windows obligatoire. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Nom de l'exécutable / de l'app (WilcoATC.exe). Le RootNamespace reste FreqWatch :
         il pilote le préfixe des ressources embarquées et les espaces de noms internes. -->
    <AssemblyName>WilcoATC</AssemblyName>
    <RootNamespace>FreqWatch</RootNamespace>
    <!-- Icône de l'exécutable / de la barre des tâches, générée depuis Assets\logo.png. -->
    <ApplicationIcon>Assets\wilcoatc.ico</ApplicationIcon>

    <!-- MSFS et le SimConnect natif sont 64 bits : on force x64, sinon le
         chargement de SimConnect.dll (natif) échoue avec BadImageFormatException. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- RID win-x64 : copie les DLL natives (sherpa-onnx-c-api.dll, onnxruntime.dll)
         à côté de l'exécutable. Framework-dependent (pas self-contained). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Dépendances gratuites :
       - NAudio        : DSP + lecture audio
       - System.Speech : voix Windows (fallback de secours)
       - sherpa-onnx   : TTS Piper/VITS 100 % NATIVE en C# (moteur par défaut, offline)
       - SharpCompress : extraction .tar.bz2 des modèles de voix (pur managé) -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Lecture des .ogg (Vorbis) des packs de sons de cabine : NAudio ne les gère pas seul. -->
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
  </ItemGroup>

  <!-- ============================================================
       Référence au wrapper managé fourni par le SDK MSFS.
       La DLL est embarquée dans libs/ (voir libs/README.txt).
       <Private>true</Private> => copiée à côté de l'exécutable.
       ============================================================ -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>..\..\libs\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Logo de l'app : ressource WPF (pack://…/Assets/logo.png) pour l'en-tête et les
       icônes de fenêtre. wilcoatc.ico en est dérivé (voir ApplicationIcon). -->
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- Table de règles ATC embarquée (extraite dans %LOCALAPPDATA% au 1er lancement). -->
  <ItemGroup>
    <None Remove="Atc\Brain\atc-rules.json" />
    <EmbeddedResource Include="Atc\Brain\atc-rules.json" />
  </ItemGroup>

  <!-- Dataset télophonie compagnie (OpenFlights) embarqué. -->
  <ItemGroup>
    <None Remove="Data\airlines.dat" />
    <EmbeddedResource Include="Data\airlines.dat" />
  </ItemGroup>

  <!-- La DLL NATIVE SimConnect.dll doit se trouver À CÔTÉ de l'exécutable.
       On la copie depuis libs/ si elle est présente. -->
  <ItemGroup>
    <None Include="..\..\libs\SimConnect.dll" Condition="Exists('..\..\libs\SimConnect.dll')">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- (Stretch) Fichiers OurAirports optionnels : copiés dans data/ s'ils existent. -->
  <ItemGroup>
    <None Include="..\..\data\*.csv" Condition="Exists('..\..\data')">
      <Link>data\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Note : PublishSingleFile (fichier .exe unique) n'est PAS supporté pour cette app :
       le wrapper Microsoft.FlightSimulator.SimConnect.dll est un assembly MIXED-MODE
       (C++/CLI) que .NET ne peut pas embarquer dans un exe unique (BadImageFormatException).
       Distribuer plutôt le build self-contained en DOSSIER (dossier zippé). -->

</Project>
