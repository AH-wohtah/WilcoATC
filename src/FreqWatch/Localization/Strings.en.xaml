<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Common ===== -->
    <sys:String x:Key="S.App.Tagline">Connected ATC · SimConnect</sys:String>
    <sys:String x:Key="S.Btn.Settings">⚙  Settings</sys:String>
    <sys:String x:Key="S.Btn.Save">💾  Save</sys:String>
    <sys:String x:Key="S.Btn.Close">Close</sys:String>
    <sys:String x:Key="S.Btn.TestVoice">▶  Test voice</sys:String>
    <sys:String x:Key="S.Btn.Send">Send</sys:String>

    <!-- ===== Main window ===== -->
    <sys:String x:Key="S.Test.BannerTitle">⚠  TEST MODE ACTIVE</sys:String>
    <sys:String x:Key="S.Test.BannerText">&#8212;  controller / on-ground checks disabled: every request is granted</sys:String>
    <sys:String x:Key="S.Atc.VoiceToggle">ATC voice</sys:String>
    <sys:String x:Key="S.Atc.TestMode">🧪 Test Mode</sys:String>
    <sys:String x:Key="S.Atc.TestModeTip">Grants every request regardless of frequency or being on the ground (bypasses the remaining checks).</sys:String>
    <sys:String x:Key="S.Atc.TestBtn">▶  Test ATC (F1)</sys:String>
    <sys:String x:Key="S.Sect.Aircraft">AIRCRAFT</sys:String>
    <sys:String x:Key="S.Sect.NearestAirport">NEAREST AIRPORT</sys:String>
