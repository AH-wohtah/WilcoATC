    <sys:String x:Key="S.Status.Ready">Ready</sys:String>
    <sys:String x:Key="S.Status.Transmitting">Transmitting…</sys:String>
    <sys:String x:Key="S.Status.AudioError">Audio error</sys:String>
    <sys:String x:Key="S.Status.Listening">listening to mic…</sys:String>
    <sys:String x:Key="S.Status.Transcribing">transcribing…</sys:String>
    <sys:String x:Key="S.Status.NothingHeard">nothing understood</sys:String>
    <sys:String x:Key="S.Status.MicUnavailable">mic unavailable</sys:String>
    <sys:String x:Key="S.Atc.StatusPrefix">ATC: </sys:String>
    <sys:String x:Key="S.Atc.StatusDash">ATC: —</sys:String>
    <sys:String x:Key="S.Readback.Yes">readback expected: YES</sys:String>
    <sys:String x:Key="S.Readback.No">readback expected: no</sys:String>
    <sys:String x:Key="S.Phase.Ground">ground</sys:String>
    <sys:String x:Key="S.Phase.Air">air</sys:String>
    <sys:String x:Key="S.Decision.Granted">GRANTED</sys:String>
    <sys:String x:Key="S.Decision.Denied">DENIED</sys:String>
    <sys:String x:Key="S.Btn.Speak">🎙  Speak</sys:String>
    <sys:String x:Key="S.Btn.Transcribe">⏹  Transcribe</sys:String>
    <sys:String x:Key="S.Waiting">Waiting for the simulator…</sys:String>

    <!-- ===== Settings — Immersion ===== -->
    <sys:String x:Key="S.Tab.Immersion">🎧   Immersion</sys:String>
    <sys:String x:Key="S.Imm.Title">Immersion</sys:String>
    <sys:String x:Key="S.Imm.Subtitle">A virtual first officer, ambient radio traffic and cabin sound packs. Each one can be turned on or off independently.</sys:String>
    <sys:String x:Key="S.Imm.Copilot">Virtual first officer (callouts)</sys:String>
    <sys:String x:Key="S.Imm.CopilotHint">Calls out 80 knots, V1, rotate, V2, positive rate, altitudes, minimums and the landing callouts — driven live by the simulator. Spoken on the intercom (no radio effect).</sys:String>
    <sys:String x:Key="S.Imm.Checklists">Also announce checklists</sys:String>
    <sys:String x:Key="S.Imm.VSpeeds">Reference speeds (kt)</sys:String>
    <sys:String x:Key="S.Imm.VSpeedsHint">SimConnect does not expose reliable V-speeds, so set them for your aircraft and weight.</sys:String>
    <sys:String x:Key="S.Imm.Chatter">Ambient radio traffic</sys:String>
    <sys:String x:Key="S.Imm.ChatterHint">Other crews and controllers talking on the frequency, to populate the airwaves. Purely cosmetic — no traffic is created in the simulator. Never talks over the real ATC.</sys:String>
    <sys:String x:Key="S.Imm.ChatterGap">Delay between transmissions (min — max)</sys:String>
    <sys:String x:Key="S.Imm.ComingSoon">COMING SOON</sys:String>
    <sys:String x:Key="S.Imm.CabinComingSoonHint">Cabin sound packs are not available yet — the settings below are disabled and no cabin audio is played. They will be enabled in a future update.</sys:String>
    <sys:String x:Key="S.Imm.Cabin">Cabin sound packs</sys:String>
    <sys:String x:Key="S.Imm.CabinHint">Cabin announcements and ambience triggered by the flight phase (boarding, safety demo, takeoff, cruise, descent, landing, deboarding).</sys:String>
    <sys:String x:Key="S.Imm.CabinPack">Sound pack</sys:String>
    <sys:String x:Key="S.Imm.CabinAddHint">One sub-folder per pack (or drop files straight in). Formats: .ogg, .wav, .mp3. Naming is flexible — a file just has to CONTAIN its keyword: boarding / safety / takeoff / cruise / descent / landing / deboarding (e.g. "PA_Boarding.ogg"). The list shows how many events were recognised; press Refresh after adding files.</sys:String>
    <sys:String x:Key="S.Btn.OpenCabinFolder">📁  Open cabin packs folder</sys:String>
    <sys:String x:Key="S.Imm.Experimental">EXPERIMENTAL</sys:String>
    <sys:String x:Key="S.Imm.CopilotVoice">First officer voice</sys:String>
    <sys:String x:Key="S.Imm.CopilotVoiceHint">Pick a different voice from the ATC one so the cockpit feels alive. Install more voices in the “ATC voice” tab.</sys:String>
    <sys:String x:Key="S.Ptt.Title">Push-to-talk key</sys:String>
    <sys:String x:Key="S.Ptt.Hint">Hold this key to talk to ATC — it works even while the simulator has focus. The key is never swallowed: it still reaches the sim.</sys:String>
    <sys:String x:Key="S.Ptt.SetKey">Set key…</sys:String>
    <sys:String x:Key="S.Ptt.Clear">Clear</sys:String>

</ResourceDictionary>
