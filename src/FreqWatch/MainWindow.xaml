<Window x:Class="FreqWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreqWatch.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="WilcoATC — ATC SimConnect"
        Icon="/Assets/logo.png"
        Height="760" Width="1140" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- ============ Carte radio COM ============ -->
        <DataTemplate x:Key="ComRadioTemplate" DataType="{x:Type vm:ComRadioViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" CornerRadius="6" Padding="9,3"
                                Background="{StaticResource OrangeBrush}"
                                Visibility="{Binding IsTransmitting, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TX" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                       FontSize="11" Foreground="#1A0E00"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Active}" FontFamily="{StaticResource MonoFont}"
                               FontSize="46" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"
                               Margin="0,8,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFC24B" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STBY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Standby}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="22" Foreground="{StaticResource CyanBrush}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Station}" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12.5" Margin="0,7,0,0"
                                   Visibility="{Binding HasStation, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding TestTransmissionCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Bandeau MODE TEST ================= -->
        <Border Grid.Row="0" Background="{StaticResource OrangeBrush}" Padding="20,8"
                Visibility="{Binding TestModeEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S.Test.BannerTitle}" FontFamily="{StaticResource MonoFont}"
                           FontWeight="Bold" FontSize="13.5" Foreground="#1A0E00" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource S.Test.BannerText}"
                           FontSize="12.5" Foreground="#331A00" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= En-tête ================= -->
        <Border Grid.Row="1" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo de l'app. Viewbox recadre le fond perdu autour du dessin
                         pour que la marque remplisse bien la pastille. -->
                    <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"
                                        Viewbox="0.15,0.15,0.7,0.7"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WilcoATC" FontFamily="{StaticResource MonoFont}" FontSize="19"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource S.App.Tagline}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5" Margin="1,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissingDependency}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="Pulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.3" Duration="0:0:0.9"
                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="{DynamicResource S.Btn.Settings}" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource ToolButton}" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Barre ATC ================= -->
        <Border Grid.Row="2" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="22,11">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource S.Atc.VoiceToggle}" IsChecked="{Binding AtcEnabled}" Style="{StaticResource SwitchToggle}"
                              FontWeight="SemiBold"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="18,3" Height="20"/>
                    <TextBlock Text="{Binding AtcStatus}" Foreground="{StaticResource TextDimBrush}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource S.Atc.TestMode}" IsChecked="{Binding TestModeEnabled}"
                              Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                              ToolTip="{DynamicResource S.Atc.TestModeTip}"/>
                    <Button Content="{DynamicResource S.Atc.TestBtn}" Command="{Binding TestTransmissionCommand}"
                            Style="{StaticResource ToolButton}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Contenu ================= -->
        <Grid Grid.Row="3" Margin="18,16,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>
                    <ContentControl Content="{Binding Com1}" ContentTemplate="{StaticResource ComRadioTemplate}"/>
                    <ContentControl Content="{Binding Com2}" ContentTemplate="{StaticResource ComRadioTemplate}"/>

                    <!-- ===== Avion + aéroport proche ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Sect.Aircraft}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding AircraftTitle}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding TailNumber}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="14" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="{Binding AircraftType}" Foreground="{StaticResource TextDimBrush}"
                                           FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,14,0,12"/>
                            <TextBlock Text="{DynamicResource S.Sect.NearestAirport}" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding NearestAirport}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Vol ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Sect.Flight}" Style="{StaticResource SectionLabel}" Margin="0,0,0,14"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="IAS" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Ias}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="GS" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding GroundSpeed}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="V/S" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding VerticalSpeed}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource S.Metric.AltMsl}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding AltitudeMsl}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource S.Metric.Agl}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding AltitudeAgl}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource S.Metric.Hdg}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Heading}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SQUAWK" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Squawk}" Style="{StaticResource MetricValue}"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Metric.State}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding GroundState}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,2,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="LAT" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Latitude}" Style="{StaticResource MetricValue}" FontSize="15"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="LON" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Longitude}" Style="{StaticResource MetricValue}" FontSize="15"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Plan de vol ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding HasFlightPlan, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Sect.FlightPlan}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding FlightPlanCallsign}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Metric.Route}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding FlightPlanRoute}" Style="{StaticResource MetricValue}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Metric.Cruise}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding FlightPlanCruise}" Style="{StaticResource MetricValue}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Sect.Aircraft}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding FlightPlanAircraft}" Style="{StaticResource MetricValue}" FontSize="14"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Journal ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Sect.Log}" Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,14"/>
                    <ListBox Style="{StaticResource LogListBox}" ItemsSource="{Binding Log}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12.5" Width="72"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Kind, Converter={StaticResource LogKindToBrush}}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                               TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Console pilote ================= -->
        <Border Grid.Row="4" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="18,13">
            <StackPanel>
                <!-- Ligne info : phase + collationnement -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PHASE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PhaseDebugText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12.5" Foreground="{StaticResource CyanBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ReadbackState}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource AmberBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Ligne forçage (visible en Mode Test) -->
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,11"
                        Visibility="{Binding TestModeEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S.Console.Force}" Style="{StaticResource SectionLabel}"
                                   Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.Console.Controller}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox Width="130" ItemsSource="{Binding ControllerOverrides}"
                                  SelectedItem="{Binding SelectedControllerOverride}" VerticalAlignment="Center"/>
                        <!-- Le forçage de PHASE a disparu : plus aucune requête n'est refusée
                             pour cause de phase, il n'y a donc plus rien à contourner. -->
                        <CheckBox Content="CLEARED_FOR_TAKEOFF" IsChecked="{Binding ForceClearedForTakeoff}"
                                  VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ligne saisie : requête pilote -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,12,0"
                             Text="{Binding PilotRequestText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}" FontSize="14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendPilotRequestCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF3B3B" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Button Content="{Binding ListenButtonText}" Command="{Binding ToggleListenCommand}"
                                Style="{StaticResource ToolButton}" IsEnabled="{Binding SpeechAvailable}"
                                ToolTip="{DynamicResource S.Console.MicTip}"/>
                        <Button Content="{DynamicResource S.Btn.Send}" Command="{Binding SendPilotRequestCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Lecture debug : transcription -> intention -> décision -->
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource S.Console.Transcription}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LastTranscript}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0">
                        <TextBlock Text="{DynamicResource S.Console.Intent}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LastIntentText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource AmberBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0,0,0">
                        <TextBlock Text="{DynamicResource S.Console.Decision}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LastDecisionText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastDecisionApproved}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
