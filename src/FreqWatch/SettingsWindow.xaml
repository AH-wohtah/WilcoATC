<Window x:Class="FreqWatch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreqWatch.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="WilcoATC"
        Icon="/Assets/logo.png"
        Height="680" Width="900" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource NavTabs}">

            <!-- ================= GETTING STARTED ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Start}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Start.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Start.Subtitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S.Start.Step1Title}"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12" Text="{DynamicResource S.Start.Step1Hint}"/>
                                <Button Content="{DynamicResource S.Btn.TestVoice}" Command="{Binding TestVoiceCommand}"
                                        Style="{StaticResource ToolButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S.Start.Step2Title}"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,10" Text="{DynamicResource S.Start.Step2Hint}"/>
                                <TextBlock Text="{Binding SpeechModelStatus}" Style="{StaticResource FieldHint}" Margin="0,0,0,12"/>
                                <Button Content="{DynamicResource S.Btn.DownloadSttModel}" Command="{Binding DownloadSpeechModelCommand}"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S.Start.Step3Title}"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,10" Text="{DynamicResource S.Start.Step3Hint}"/>
                                <TextBlock Text="{DynamicResource S.Start.SimbriefLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SimBriefUsername}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource S.Btn.ImportSimbrief}" Command="{Binding ImportSimBriefCommand}"
                                            Style="{StaticResource ToolButton}"/>
                                    <Button Content="{DynamicResource S.Btn.LoadOfp}" Command="{Binding LoadOfpCommand}"
                                            Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource FieldHint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic : où trouver le journal quand l'app « ne fait rien ». -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Log.Title}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,12"
                                           Text="{DynamicResource S.Log.Hint}"/>
                                <Button Content="{DynamicResource S.Btn.OpenLogs}" Command="{Binding OpenLogsFolderCommand}"
                                        Style="{StaticResource ToolButton}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding LogFilePath}" Style="{StaticResource FieldHint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource FieldHint}" Margin="2,6,0,0" Text="{DynamicResource S.Start.FinalNote}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= LANGUAGE ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Language}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Lang.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Lang.Subtitle}"/>

                        <TextBlock Text="{DynamicResource S.Lang.Select}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Lang.Hint}" Style="{StaticResource FieldHint}"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedAppLanguage}"
                                  DisplayMemberPath="DisplayName" Width="280" HorizontalAlignment="Left" Margin="0,0,0,24"/>

                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Lang.AddTitle}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Lang.AddHint}" Style="{StaticResource FieldHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource S.Btn.OpenLangFolder}" Command="{Binding OpenLanguagesFolderCommand}"
                                    Style="{StaticResource ToolButton}"/>
                            <Button Content="{DynamicResource S.Btn.Refresh}" Command="{Binding RefreshLanguagesCommand}"
                                    Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ATC VOICE (TTS) ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Voice}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Voice.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Voice.Subtitle}"/>

                        <TextBlock Text="{DynamicResource S.Voice.Engine}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Voice.EngineHint}" Style="{StaticResource FieldHint}"/>
                        <ComboBox ItemsSource="{Binding TtsEngines}" SelectedItem="{Binding SelectedTtsEngine}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Voice.Installed}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SherpaVoices}" SelectedItem="{Binding SherpaVoiceName}" Margin="0,4,0,20"/>

                        <TextBlock Text="{DynamicResource S.Voice.Speed}" Style="{StaticResource FieldLabel}"/>
                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding SherpaSpeed}" Margin="0,4,0,20" Width="300" HorizontalAlignment="Left"/>

                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Voice.AddVoice}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Voice.AddVoiceHint}" Style="{StaticResource FieldHint}"/>
                        <ComboBox ItemsSource="{Binding CatalogVoices}" SelectedItem="{Binding SelectedCatalogVoice}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{DynamicResource S.Btn.DownloadVoice}" Command="{Binding DownloadVoiceCommand}"
                                    Style="{StaticResource ToolButton}"/>
                            <Button Content="{DynamicResource S.Btn.VoicesFolder}" Command="{Binding OpenVoicesFolderCommand}"
                                    Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Content="{Binding DownloadAllSummary}" Command="{Binding DownloadAllVoicesCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,6"/>
                        <TextBlock Text="{DynamicResource S.Voice.DownloadAllHint}" Style="{StaticResource FieldHint}"/>
                        <TextBlock Text="{Binding VoicesDir}" Style="{StaticResource FieldHint}"/>

                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,12,0,20"/>

                        <TextBlock Text="{DynamicResource S.Voice.WindowsVoice}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding WindowsVoice}" Margin="0,4,0,20"/>

                        <TextBlock Text="{DynamicResource S.Voice.GoogleVoice}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox IsEditable="True" ItemsSource="{Binding GoogleVoices}" Text="{Binding GoogleVoiceName}" Margin="0,4,0,14"/>
                        <TextBlock Text="{DynamicResource S.Voice.GoogleKey}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GoogleApiKeyEnvVar}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= MIC (STT) ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Mic}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Mic.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Mic.Subtitle}"/>

                        <TextBlock Text="{DynamicResource S.Mic.Device}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}" Margin="0,4,0,22"/>

                        <TextBlock Text="{DynamicResource S.Mic.Model}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SpeechModelStatus}" Style="{StaticResource FieldHint}"/>
                        <TextBlock Text="{DynamicResource S.Mic.ModelHint}" Style="{StaticResource FieldHint}"/>
                        <Button Content="{DynamicResource S.Btn.DownloadSttModel}" Command="{Binding DownloadSpeechModelCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,22"/>

                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Ptt.Title}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Ptt.Hint}" Style="{StaticResource FieldHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Style="{StaticResource Chip}" VerticalAlignment="Center" MinWidth="90">
                                <TextBlock Text="{Binding PttKeyDisplay}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Content="{DynamicResource S.Ptt.SetKey}" Command="{Binding CapturePttCommand}"
                                    Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                            <Button Content="{DynamicResource S.Ptt.Clear}" Command="{Binding ClearPttCommand}"
                                    Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= AUDIO & RADIO ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Audio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Audio.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Audio.Subtitle}"/>

                        <TextBlock Text="{DynamicResource S.Audio.OutputDevice}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedDevice}" Margin="0,4,0,22"/>

                        <TextBlock Text="{DynamicResource S.Audio.RadioEffect}" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Audio.BandPass}" IsChecked="{Binding RadioBandPass}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Audio.Hiss}" IsChecked="{Binding RadioHiss}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Audio.Squelch}" IsChecked="{Binding RadioSquelch}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Audio.Saturation}" IsChecked="{Binding RadioSaturation}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Audio.Volume}" Style="{StaticResource FieldLabel}"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding RadioVolume}" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ATC ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Atc}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.AtcTab.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.AtcTab.Subtitle}"/>

                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.AtcTab.AutoContact}" IsChecked="{Binding AtcAutoContact}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,20" Text="{DynamicResource S.AtcTab.AutoContactHint}"/>

                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.AtcTab.Gsx}" IsChecked="{Binding GsxIntegrationEnabled}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.AtcTab.GsxHint}"/>

                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,20"/>

                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.AtcTab.TestMode}" IsChecked="{Binding TestMode}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" Text="{DynamicResource S.AtcTab.TestModeHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= IMMERSION ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Immersion}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Imm.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Imm.Subtitle}"/>

                        <!-- Copilote -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Imm.Copilot}"
                                              IsChecked="{Binding CopilotEnabled}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource AmberBrush}" CornerRadius="5" Padding="7,2"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Imm.Experimental}" FontSize="10.5"
                                                   FontWeight="Bold" Foreground="#1A0E00"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,14" Text="{DynamicResource S.Imm.CopilotHint}"/>

                                <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Imm.Checklists}"
                                          IsChecked="{Binding CopilotChecklists}" Margin="0,0,0,16"/>

                                <TextBlock Text="{DynamicResource S.Imm.CopilotVoice}" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{DynamicResource S.Imm.CopilotVoiceHint}" Style="{StaticResource FieldHint}"/>
                                <ComboBox ItemsSource="{Binding SherpaVoices}" SelectedItem="{Binding CopilotVoiceName}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="{DynamicResource S.Imm.VSpeeds}" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{DynamicResource S.Imm.VSpeedsHint}" Style="{StaticResource FieldHint}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="V1" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding CopilotV1Knots}" Width="70"/>
                                    <TextBlock Text="VR" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                    <TextBox Text="{Binding CopilotVrKnots}" Width="70"/>
                                    <TextBlock Text="V2" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                    <TextBox Text="{Binding CopilotV2Knots}" Width="70"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Trafic ambiant -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Imm.Chatter}"
                                          IsChecked="{Binding ChatterEnabled}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,14" Text="{DynamicResource S.Imm.ChatterHint}"/>

                                <TextBlock Text="{DynamicResource S.Imm.ChatterGap}" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox Text="{Binding ChatterMinGapSeconds}" Width="70"/>
                                    <TextBlock Text="—" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBox Text="{Binding ChatterMaxGapSeconds}" Width="70"/>
                                    <TextBlock Text="s" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sons de cabine — DÉSACTIVÉ (à venir). Le titre et le badge restent
                             lisibles ; seuls les réglages sont grisés et inopérants. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource S.Imm.Cabin}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="7,2"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Imm.ComingSoon}" FontSize="10.5"
                                                   FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                                           Text="{DynamicResource S.Imm.CabinComingSoonHint}"/>

                                <!-- Grisé tant que la fonction n'est pas livrée. -->
                                <StackPanel IsEnabled="False" Opacity="0.45" Margin="0,14,0,0">
                                    <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Imm.Cabin}"
                                              IsChecked="{Binding CabinEnabled}"/>
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,14" Text="{DynamicResource S.Imm.CabinHint}"/>

                                    <TextBlock Text="{DynamicResource S.Imm.CabinPack}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding CabinPacks}" SelectedItem="{Binding SelectedCabinPack}"
                                              Margin="0,4,0,16"/>

                                    <TextBlock Text="{DynamicResource S.Audio.Volume}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding CabinVolume}" Width="300"
                                            HorizontalAlignment="Left" Margin="0,4,0,16"/>

                                    <TextBlock Text="{DynamicResource S.Imm.CabinAddHint}" Style="{StaticResource FieldHint}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{DynamicResource S.Btn.OpenCabinFolder}" Command="{Binding OpenCabinFolderCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                        <Button Content="{DynamicResource S.Btn.Refresh}" Command="{Binding RefreshCabinPacksCommand}"
                                                Style="{StaticResource ToolButton}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CabinPacksDir}" Style="{StaticResource FieldHint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= HANDOFFS / CENTER ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Transfers}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Tr.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Tr.Subtitle}"/>

                        <CheckBox Style="{StaticResource SwitchToggle}" Content="{DynamicResource S.Tr.Vatsim}" IsChecked="{Binding VatsimEnabled}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Tr.VatsimHint}"/>

                        <TextBlock Text="{DynamicResource S.Tr.CenterName}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Tr.CenterNameHint}" Style="{StaticResource FieldHint}"/>
                        <TextBox Text="{Binding CenterName}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Tr.CenterFreq}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CenterFrequencyMhz}" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ADVANCED (LLM) ================= -->
            <TabItem Style="{StaticResource NavTabItem}" Header="{DynamicResource S.Tab.Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S.Adv.Title}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,22" Text="{DynamicResource S.Adv.Subtitle}"/>

                        <TextBlock Text="{DynamicResource S.Adv.Mode}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{DynamicResource S.Adv.ModeHint}" Style="{StaticResource FieldHint}"/>
                        <ComboBox ItemsSource="{Binding LlmModes}" SelectedItem="{Binding SelectedLlmMode}" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource S.Adv.OllamaUrl}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OllamaUrl}" Margin="0,4,0,14"/>
                        <TextBlock Text="{DynamicResource S.Adv.OllamaModel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OllamaModel}" Margin="0,4,0,20"/>

                        <TextBlock Text="{DynamicResource S.Adv.CloudUrl}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CloudBaseUrl}" Margin="0,4,0,14"/>
                        <TextBlock Text="{DynamicResource S.Adv.CloudModel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CloudModel}" Margin="0,4,0,14"/>
                        <TextBlock Text="{DynamicResource S.Adv.CloudKey}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CloudApiKeyEnvVar}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Footer ================= -->
        <Border Grid.Row="1" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Button Content="{DynamicResource S.Btn.TestVoice}" Command="{Binding TestVoiceCommand}"
                        Style="{StaticResource ToolButton}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource S.Btn.Close}" Style="{StaticResource ToolButton}" Click="OnClose"/>
                    <Button Content="{DynamicResource S.Btn.Save}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
