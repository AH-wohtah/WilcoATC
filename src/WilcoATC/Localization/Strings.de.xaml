    <sys:String x:Key="S.Console.Intent">ABSICHT</sys:String>
    <sys:String x:Key="S.Console.Decision">ENTSCHEIDUNG</sys:String>
    <sys:String x:Key="S.Console.MicTip">Spracherkennung (Whisper). Falls deaktiviert: Modell unter Einstellungen ▸ Mikro herunterladen.</sys:String>

    <sys:String x:Key="S.Tab.Start">🚀   Erste Schritte</sys:String>
    <sys:String x:Key="S.Tab.Language">🌐   Sprache</sys:String>
    <sys:String x:Key="S.Tab.Voice">🔊   ATC-Stimme</sys:String>
