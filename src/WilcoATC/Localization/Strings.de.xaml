    <sys:String x:Key="S.Status.Listening">höre Mikro…</sys:String>
    <sys:String x:Key="S.Status.Transcribing">transkribiere…</sys:String>
    <sys:String x:Key="S.Status.NothingHeard">nichts verstanden</sys:String>
    <sys:String x:Key="S.Status.MicUnavailable">Mikro nicht verfügbar</sys:String>
    <sys:String x:Key="S.Atc.StatusPrefix">ATC: </sys:String>
    <sys:String x:Key="S.Atc.StatusDash">ATC: —</sys:String>
    <sys:String x:Key="S.Readback.Yes">Rückmeldung erwartet: JA</sys:String>
    <sys:String x:Key="S.Readback.No">Rückmeldung erwartet: nein</sys:String>
    <sys:String x:Key="S.Phase.Ground">Boden</sys:String>
    <sys:String x:Key="S.Phase.Air">Luft</sys:String>
