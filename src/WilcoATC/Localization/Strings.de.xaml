    <sys:String x:Key="S.Metric.State">STATUS</sys:String>
    <sys:String x:Key="S.Sect.FlightPlan">FLUGPLAN (SIMBRIEF)</sys:String>
    <sys:String x:Key="S.Metric.Route">ROUTE</sys:String>
    <sys:String x:Key="S.Metric.Cruise">REISEFLUG</sys:String>
