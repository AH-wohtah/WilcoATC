    <sys:String x:Key="S.Sect.AirportFreqs">Flughafenfrequenzen</sys:String>
    <sys:String x:Key="S.Freqs.NoAirport">Noch kein Flughafen in der Nähe — der Simulator hat keinen gemeldet.</sys:String>
    <sys:String x:Key="S.Freqs.None">Für diesen Flughafen sind in den mitgelieferten Daten keine Frequenzen hinterlegt.</sys:String>
