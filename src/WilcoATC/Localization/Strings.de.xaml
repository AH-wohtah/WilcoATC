<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="S.App.Tagline">Verbundenes ATC · SimConnect</sys:String>
    <sys:String x:Key="S.Btn.Settings">⚙  Einstellungen</sys:String>
    <sys:String x:Key="S.Btn.Save">💾  Speichern</sys:String>
    <sys:String x:Key="S.Btn.Close">Schließen</sys:String>
    <sys:String x:Key="S.Btn.TestVoice">▶  Stimme testen</sys:String>
    <sys:String x:Key="S.Btn.Send">Senden</sys:String>

    <sys:String x:Key="S.Test.BannerTitle">⚠  TESTMODUS AKTIV</sys:String>
    <sys:String x:Key="S.Test.BannerText">—  Phasen-/Lotsenprüfung deaktiviert: jede Anfrage wird genehmigt</sys:String>
    <sys:String x:Key="S.Atc.VoiceToggle">ATC-Stimme</sys:String>
    <sys:String x:Key="S.Atc.TestMode">🧪 Testmodus</sys:String>
    <sys:String x:Key="S.Atc.TestModeTip">Genehmigt jede Anfrage unabhängig von Phase / Frequenz (umgeht die Prüfung).</sys:String>
    <sys:String x:Key="S.Atc.TestBtn">▶  ATC testen (F1)</sys:String>
