    <!-- ===== Settings — Getting started ===== -->
    <sys:String x:Key="S.Start.Title">Welcome to WilcoATC</sys:String>
    <sys:String x:Key="S.Start.Subtitle">A voice ATC connected to Microsoft Flight Simulator. Three things to set up to get going — everything else already works out of the box.</sys:String>
    <sys:String x:Key="S.Start.Step1Title">1 · ATC voice</sys:String>
    <sys:String x:Key="S.Start.Step1Hint">A neural voice (offline, no key) is downloaded on first launch. Listen to it; you can change it in the “ATC voice” tab.</sys:String>
    <sys:String x:Key="S.Start.Step2Title">2 · Voice recognition (talk to ATC)</sys:String>
    <sys:String x:Key="S.Start.Step2Hint">To use the &#127897; button and speak into your mic, download the recognition model (offline, ~460 MB, once).</sys:String>
    <sys:String x:Key="S.Start.Step3Title">3 · Flight plan (recommended)</sys:String>
    <sys:String x:Key="S.Start.Step3Hint">Import your SimBrief flight to get the airline callsign, route and departure SID. Otherwise ATC uses the tail number.</sys:String>
    <sys:String x:Key="S.Start.SimbriefLabel">SimBrief username (or Pilot ID)</sys:String>
    <sys:String x:Key="S.Start.FinalNote">All detailed settings (audio, radio effect, handoffs, language…) are in the tabs on the left.</sys:String>
    <sys:String x:Key="S.Btn.ImportSimbrief">⤓  Import from SimBrief</sys:String>
    <sys:String x:Key="S.Btn.LoadOfp">📄  Load an OFP file…</sys:String>
    <sys:String x:Key="S.Btn.DownloadVoiceModel">⤓  Download the voice model</sys:String>

    <sys:String x:Key="S.Log.Title">Diagnostics</sys:String>
    <sys:String x:Key="S.Log.Hint">Every launch writes a log file: dependencies found or missing, simulator connection, and any error. If the app does nothing on startup, this file says why. The last 10 launches are kept.</sys:String>
    <sys:String x:Key="S.Btn.OpenLogs">&#128193;  Open logs folder</sys:String>

    <!-- ===== Settings — Language ===== -->
    <sys:String x:Key="S.Lang.Title">Language</sys:String>
    <sys:String x:Key="S.Lang.Subtitle">Sets the language of the app interface. Radio always stays in English.</sys:String>
    <sys:String x:Key="S.Lang.Select">Application language</sys:String>
    <sys:String x:Key="S.Lang.Hint">The change applies immediately. ATC, the copilot and ambient traffic always speak English — standard ICAO phraseology — and voice recognition listens in English too.</sys:String>
    <sys:String x:Key="S.Lang.AddTitle">Add a language</sys:String>
    <sys:String x:Key="S.Lang.AddHint">To add another interface language, drop a translation file &lt;code&gt;.xaml (e.g. sv.xaml) into the languages folder, then Refresh.</sys:String>
    <sys:String x:Key="S.Btn.OpenLangFolder">📁  Open languages folder</sys:String>
    <sys:String x:Key="S.Btn.Refresh">↻  Refresh</sys:String>

