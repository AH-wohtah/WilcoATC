    <!-- ===== Settings — Mic (STT) ===== -->
    <sys:String x:Key="S.Mic.Title">Voice recognition (speech-to-text)</sys:String>
    <sys:String x:Key="S.Mic.Subtitle">Talk to ATC with the &#127897; button of the pilot console (press = talk, press again = transcribe). Offline engine, no key.</sys:String>
    <sys:String x:Key="S.Mic.Device">Microphone</sys:String>
    <sys:String x:Key="S.Mic.Model">Recognition model</sys:String>
    <sys:String x:Key="S.Mic.ModelHint">Parakeet TDT 0.6B (NVIDIA NeMo), ~460 MB, downloaded once. No key, no cloud. It is the most accurate free offline model available here — measured at roughly 40% fewer word errors than Whisper on ATC phraseology, and no slower. Speak standard phraseology (“request pushback”, “ready for departure”) and it will be understood even if a word is misheard.</sys:String>
    <sys:String x:Key="S.Btn.DownloadSttModel">&#10515;  Download the model (Parakeet, ~460 MB)</sys:String>
    <sys:String x:Key="S.Mic.StatusInstalled">Voice recognition model installed — multilingual, it understands every supported language.</sys:String>
    <sys:String x:Key="S.Mic.StatusEnglishOnly">An ENGLISH-ONLY recognition model is installed. Download the current model below to be understood in French, German, Spanish and Italian too.</sys:String>
    <sys:String x:Key="S.Mic.StatusMissing">No model installed — voice recognition is unavailable.</sys:String>

