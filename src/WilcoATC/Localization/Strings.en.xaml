    <sys:String x:Key="S.Gate.Download">Download</sys:String>
    <sys:String x:Key="S.Gate.Note">The download is several hundred megabytes and may take a few minutes. Nothing goes over the internet afterwards: both speech and recognition run on your machine.</sys:String>
