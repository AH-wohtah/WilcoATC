<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Commun ===== -->
    <sys:String x:Key="S.App.Tagline">ATC connecté · SimConnect</sys:String>
    <sys:String x:Key="S.Btn.Settings">⚙  Réglages</sys:String>
    <sys:String x:Key="S.Btn.Save">💾  Enregistrer</sys:String>
    <sys:String x:Key="S.Btn.Close">Fermer</sys:String>
    <sys:String x:Key="S.Btn.TestVoice">▶  Tester la voix</sys:String>
    <sys:String x:Key="S.Btn.Send">Envoyer</sys:String>

    <!-- ===== Fenêtre principale ===== -->
    <sys:String x:Key="S.Test.BannerTitle">⚠  MODE TEST ACTIF</sys:String>
    <sys:String x:Key="S.Test.BannerText">—  validation de phase / contrôleur désactivée : toute requête est accordée</sys:String>
    <sys:String x:Key="S.Atc.VoiceToggle">ATC vocal</sys:String>
    <sys:String x:Key="S.Atc.TestMode">🧪 Mode Test</sys:String>
    <sys:String x:Key="S.Atc.TestModeTip">Accepte toute requête quelle que soit la phase / la fréquence (court-circuite la validation).</sys:String>
    <sys:String x:Key="S.Atc.TestBtn">▶  Test ATC (F1)</sys:String>
    <sys:String x:Key="S.Sect.Aircraft">AVION</sys:String>
    <sys:String x:Key="S.Sect.NearestAirport">AÉROPORT LE PLUS PROCHE</sys:String>
    <sys:String x:Key="S.Sect.Flight">VOL</sys:String>
    <sys:String x:Key="S.Metric.AltMsl">ALT (MSL)</sys:String>
    <sys:String x:Key="S.Metric.Agl">AGL (SOL)</sys:String>
    <sys:String x:Key="S.Metric.Hdg">CAP</sys:String>
    <sys:String x:Key="S.Metric.State">ÉTAT</sys:String>
    <sys:String x:Key="S.Sect.FlightPlan">PLAN DE VOL (SIMBRIEF)</sys:String>
    <sys:String x:Key="S.Metric.Route">ROUTE</sys:String>
    <sys:String x:Key="S.Metric.Cruise">CROISIÈRE</sys:String>
    <sys:String x:Key="S.Sect.Log">JOURNAL</sys:String>
    <sys:String x:Key="S.Console.Force">FORÇAGE (TEST)</sys:String>
    <sys:String x:Key="S.Console.Controller">Contrôleur</sys:String>
    <sys:String x:Key="S.Console.Phase">Phase</sys:String>
    <sys:String x:Key="S.Console.Transcription">TRANSCRIPTION</sys:String>
    <sys:String x:Key="S.Console.Intent">INTENT</sys:String>
    <sys:String x:Key="S.Console.Decision">DÉCISION</sys:String>
    <sys:String x:Key="S.Console.MicTip">Reconnaissance vocale (Whisper). Si désactivé : téléchargez le modèle dans Réglages ▸ Micro.</sys:String>

    <!-- ===== Réglages — onglets ===== -->
    <sys:String x:Key="S.Tab.Start">🚀   Démarrage</sys:String>
    <sys:String x:Key="S.Tab.Language">🌐   Langue</sys:String>
    <sys:String x:Key="S.Tab.Voice">🔊   Voix ATC</sys:String>
    <sys:String x:Key="S.Tab.Mic">🎙   Micro</sys:String>
    <sys:String x:Key="S.Tab.Audio">🎚   Audio &amp; radio</sys:String>
    <sys:String x:Key="S.Tab.Atc">🛫   ATC</sys:String>
    <sys:String x:Key="S.Tab.Transfers">📡   Transferts</sys:String>
    <sys:String x:Key="S.Tab.Advanced">⚙   Avancé (LLM)</sys:String>

    <!-- ===== Réglages — Démarrage ===== -->
    <sys:String x:Key="S.Start.Title">Bienvenue dans WilcoATC</sys:String>
    <sys:String x:Key="S.Start.Subtitle">Un ATC vocal connecté à Microsoft Flight Simulator. Trois choses à régler pour démarrer — tout le reste fonctionne déjà par défaut.</sys:String>
    <sys:String x:Key="S.Start.Step1Title">1 · Voix de l'ATC</sys:String>
    <sys:String x:Key="S.Start.Step1Hint">Une voix neuronale (offline, sans clé) est téléchargée au premier lancement. Écoutez-la ; vous pourrez en changer dans l'onglet « Voix ATC ».</sys:String>
    <sys:String x:Key="S.Start.Step2Title">2 · Reconnaissance vocale (parler à l'ATC)</sys:String>
    <sys:String x:Key="S.Start.Step2Hint">Pour utiliser le bouton 🎙 et parler au micro, téléchargez le modèle Whisper (offline, ~110 Mo, une seule fois).</sys:String>
    <sys:String x:Key="S.Start.Step3Title">3 · Plan de vol (recommandé)</sys:String>
    <sys:String x:Key="S.Start.Step3Hint">Importez votre vol SimBrief pour récupérer l'indicatif compagnie, la route et le SID de départ. Sinon, l'ATC utilise l'immatriculation.</sys:String>
    <sys:String x:Key="S.Start.SimbriefLabel">Identifiant SimBrief (nom d'utilisateur ou Pilot ID)</sys:String>
    <sys:String x:Key="S.Start.FinalNote">Tous les réglages détaillés (audio, effet radio, transferts, langue…) sont dans les onglets à gauche.</sys:String>
    <sys:String x:Key="S.Btn.ImportSimbrief">⤓  Importer depuis SimBrief</sys:String>
    <sys:String x:Key="S.Btn.LoadOfp">📄  Charger un fichier OFP…</sys:String>
    <sys:String x:Key="S.Btn.DownloadVoiceModel">⤓  Télécharger le modèle vocal</sys:String>

    <!-- ===== Réglages — Langue ===== -->
    <sys:String x:Key="S.Lang.Title">Langue</sys:String>
    <sys:String x:Key="S.Lang.Subtitle">Règle à la fois l'interface de l'app ET l'ATC (parlé + reconnu). Choisir « Français » met l'interface et l'ATC en français.</sys:String>
    <sys:String x:Key="S.Lang.Select">Langue de l'application</sys:String>
    <sys:String x:Key="S.Lang.Hint">Le changement s'applique immédiatement. Pour un ATC dans une autre langue, installez une voix correspondante (onglet Voix ATC) ; la reconnaissance (Whisper) est déjà multilingue.</sys:String>
    <sys:String x:Key="S.Lang.AddTitle">Ajouter une langue</sys:String>
    <sys:String x:Key="S.Lang.AddHint">L'anglais et le français sont intégrés. Pour ajouter une autre langue d'interface, déposez un fichier de traduction &lt;code&gt;.xaml (ex. de.xaml) dans le dossier des langues, puis Rafraîchir.</sys:String>
    <sys:String x:Key="S.Btn.OpenLangFolder">📁  Ouvrir le dossier des langues</sys:String>
    <sys:String x:Key="S.Btn.Refresh">↻  Rafraîchir</sys:String>

    <!-- ===== Réglages — Voix ATC (TTS) ===== -->
    <sys:String x:Key="S.Voice.Title">Voix de l'ATC (synthèse vocale)</sys:String>
    <sys:String x:Key="S.Voice.Subtitle">Le moteur par défaut « Sherpa » est une voix neuronale native, hors-ligne et gratuite.</sys:String>
    <sys:String x:Key="S.Voice.Engine">Moteur de voix</sys:String>
    <sys:String x:Key="S.Voice.EngineHint">Sherpa (recommandé) = neuronal offline. Windows = voix système de secours. Google = cloud (clé requise).</sys:String>
    <sys:String x:Key="S.Voice.Installed">Voix neuronale installée (Sherpa / Piper)</sys:String>
    <sys:String x:Key="S.Voice.Speed">Vitesse d'élocution</sys:String>
    <sys:String x:Key="S.Voice.AddVoice">Ajouter une voix (dont autres langues)</sys:String>
    <sys:String x:Key="S.Voice.AddVoiceHint">Téléchargez une voix supplémentaire depuis le catalogue sherpa-onnx (allemand, espagnol, français…).</sys:String>
    <sys:String x:Key="S.Btn.DownloadVoice">⤓  Télécharger cette voix</sys:String>
    <sys:String x:Key="S.Btn.VoicesFolder">📁  Dossier des voix</sys:String>
    <sys:String x:Key="S.Voice.WindowsVoice">Voix Windows (moteur de secours)</sys:String>
    <sys:String x:Key="S.Voice.GoogleVoice">Google — voix (moteur Google : WaveNet / Neural2 / Studio)</sys:String>
    <sys:String x:Key="S.Voice.GoogleKey">Google — variable d'environnement contenant la clé API (BYOK)</sys:String>

    <!-- ===== Réglages — Micro (STT) ===== -->
    <sys:String x:Key="S.Mic.Title">Reconnaissance vocale (STT)</sys:String>
    <sys:String x:Key="S.Mic.Subtitle">Parlez à l'ATC avec le bouton 🎙 de la console pilote (appui = parler, second appui = transcrire). Moteur Whisper offline, sans clé.</sys:String>
    <sys:String x:Key="S.Mic.Device">Microphone</sys:String>
    <sys:String x:Key="S.Mic.Model">Modèle de reconnaissance</sys:String>
    <sys:String x:Key="S.Mic.ModelHint">Modèle Whisper multilingue, ~110 Mo, téléchargé une seule fois. Aucune clé, aucun cloud.</sys:String>
    <sys:String x:Key="S.Btn.DownloadSttModel">⤓  Télécharger le modèle (Whisper, multilingue)</sys:String>
    <sys:String x:Key="S.Mic.StatusInstalled">Modèle de reconnaissance vocale installé (Whisper, multilingue).</sys:String>
    <sys:String x:Key="S.Mic.StatusMissing">Aucun modèle installé — la reconnaissance vocale est indisponible.</sys:String>

    <!-- ===== Réglages — Audio & radio ===== -->
    <sys:String x:Key="S.Audio.Title">Sortie audio &amp; effet radio</sys:String>
    <sys:String x:Key="S.Audio.Subtitle">Choisissez où sortir la voix ATC (casque, ou câble virtuel type VB-CABLE pour la séparer du son du jeu) et réglez l'effet radio.</sys:String>
    <sys:String x:Key="S.Audio.OutputDevice">Périphérique de sortie</sys:String>
    <sys:String x:Key="S.Audio.RadioEffect">Effet radio (réalisme)</sys:String>
    <sys:String x:Key="S.Audio.BandPass">Passe-bande 300–3000 Hz</sys:String>
    <sys:String x:Key="S.Audio.Hiss">Souffle de fond</sys:String>
    <sys:String x:Key="S.Audio.Squelch">Clic de squelch (ouverture / fermeture)</sys:String>
    <sys:String x:Key="S.Audio.Saturation">Saturation / compression</sys:String>
    <sys:String x:Key="S.Audio.Volume">Volume</sys:String>

    <!-- ===== Réglages — ATC ===== -->
    <sys:String x:Key="S.AtcTab.Title">Comportement de l'ATC</sys:String>
    <sys:String x:Key="S.AtcTab.Subtitle">Contact automatique, intégration GSX et mode de test.</sys:String>
    <sys:String x:Key="S.AtcTab.AutoContact">Contact initial automatique</sys:String>
    <sys:String x:Key="S.AtcTab.AutoContactHint">Quand vous vous calez sur la fréquence d'une station connue, l'ATC vous contacte automatiquement.</sys:String>
    <sys:String x:Key="S.AtcTab.Gsx">Déclencher GSX au pushback</sys:String>
    <sys:String x:Key="S.AtcTab.GsxHint">À l'autorisation de repoussage, active l'auto-pushback GSX (via beacon + frein de parking).</sys:String>
    <sys:String x:Key="S.AtcTab.TestMode">🧪 Mode Test</sys:String>
    <sys:String x:Key="S.AtcTab.TestModeHint">ON = toute requête est ACCORDÉE quelle que soit la phase ou la fréquence, et l'avertissement « décollé sans autorisation » est supprimé. La machine à états et les règles restent intactes (simplement court-circuitées). Un bandeau orange s'affiche dans la fenêtre principale tant que c'est actif.</sys:String>

    <!-- ===== Réglages — Transferts / Centre ===== -->
    <sys:String x:Key="S.Tr.Title">Transferts de fréquence / Centre</sys:String>
    <sys:String x:Key="S.Tr.Subtitle">Les fréquences Tour / Sol / Départ / Approche viennent des données OurAirports. Le Centre (en-route) n'a pas de source fiable hors-ligne.</sys:String>
    <sys:String x:Key="S.Tr.Vatsim">VATSIM : vraie fréquence de Centre si en ligne</sys:String>
    <sys:String x:Key="S.Tr.VatsimHint">Si activé et que le contrôleur est en ligne sur VATSIM, la vraie fréquence de Centre est utilisée.</sys:String>
    <sys:String x:Key="S.Tr.CenterName">Nom du Centre</sys:String>
    <sys:String x:Key="S.Tr.CenterNameHint">Ex. « Geneva » → « Geneva Center ». Renseigner ce champ ACTIVE le transfert Centre avec la fréquence approximative ci-dessous (sinon le transfert Centre est ignoré).</sys:String>
    <sys:String x:Key="S.Tr.CenterFreq">Fréquence de Centre approximative (MHz)</sys:String>

    <!-- ===== Réglages — Avancé (LLM) ===== -->
    <sys:String x:Key="S.Adv.Title">Génération de langage (optionnel)</sys:String>
    <sys:String x:Key="S.Adv.Subtitle">Par défaut, les phrases ATC viennent de gabarits (gratuit, hors-ligne). Un LLM local (Ollama) ou cloud peut les rendre plus naturelles. Facultatif.</sys:String>
    <sys:String x:Key="S.Adv.Mode">Mode</sys:String>
    <sys:String x:Key="S.Adv.ModeHint">Off = gabarits gratuits hors-ligne (recommandé pour débuter).</sys:String>
    <sys:String x:Key="S.Adv.OllamaUrl">Ollama — URL</sys:String>
    <sys:String x:Key="S.Adv.OllamaModel">Ollama — modèle</sys:String>
    <sys:String x:Key="S.Adv.CloudUrl">Cloud — URL de base (compatible OpenAI)</sys:String>
    <sys:String x:Key="S.Adv.CloudModel">Cloud — modèle</sys:String>
    <sys:String x:Key="S.Adv.CloudKey">Cloud — variable d'environnement contenant la clé (BYOK)</sys:String>

    <!-- ===== Dialogue de téléchargement ===== -->
    <sys:String x:Key="S.Dl.Title">Voix neuronale (sherpa-onnx / Piper)</sys:String>
    <sys:String x:Key="S.Dl.Preparing">Préparation…</sys:String>
    <sys:String x:Key="S.Dl.Downloading">Téléchargement…</sys:String>
    <sys:String x:Key="S.Dl.Extracting">Extraction…</sys:String>
    <sys:String x:Key="S.Dl.Installed">installé.</sys:String>
    <sys:String x:Key="S.Dl.Failed">Échec du téléchargement.</sys:String>
    <sys:String x:Key="S.Dl.ErrorPrefix">Erreur : </sys:String>

    <!-- ===== État runtime (VM) ===== -->
    <sys:String x:Key="S.Status.Ready">Prêt</sys:String>
    <sys:String x:Key="S.Status.Transmitting">Transmission…</sys:String>
    <sys:String x:Key="S.Status.AudioError">Erreur audio</sys:String>
    <sys:String x:Key="S.Status.Listening">écoute micro…</sys:String>
    <sys:String x:Key="S.Status.Transcribing">transcription…</sys:String>
    <sys:String x:Key="S.Status.NothingHeard">rien compris</sys:String>
    <sys:String x:Key="S.Status.MicUnavailable">micro indisponible</sys:String>
    <sys:String x:Key="S.Atc.StatusPrefix">ATC : </sys:String>
    <sys:String x:Key="S.Atc.StatusDash">ATC : —</sys:String>
    <sys:String x:Key="S.Readback.Yes">collationnement attendu : OUI</sys:String>
    <sys:String x:Key="S.Readback.No">collationnement attendu : non</sys:String>
    <sys:String x:Key="S.Phase.Ground">sol</sys:String>
    <sys:String x:Key="S.Phase.Air">air</sys:String>
    <sys:String x:Key="S.Decision.Granted">ACCORDÉ</sys:String>
    <sys:String x:Key="S.Decision.Denied">REFUSÉ</sys:String>
    <sys:String x:Key="S.Btn.Speak">🎙  Parler</sys:String>
    <sys:String x:Key="S.Btn.Transcribe">⏹  Transcrire</sys:String>
    <sys:String x:Key="S.Waiting">En attente du simulateur…</sys:String>

</ResourceDictionary>
