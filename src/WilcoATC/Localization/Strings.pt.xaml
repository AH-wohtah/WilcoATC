    <sys:String x:Key="S.Gate.Download">Transferir</sys:String>
    <sys:String x:Key="S.Gate.Note">A transferência ocupa várias centenas de megabytes e pode demorar alguns minutos. Depois nada passa pela internet: a síntese e o reconhecimento correm no seu computador.</sys:String>
    <sys:String x:Key="S.Gate.Continue">Continuar</sys:String>
