<Window x:Class="WilcoATC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WilcoATC.ViewModels"
        xmlns:local="clr-namespace:WilcoATC"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="WilcoATC — ATC SimConnect"
        Icon="/Assets/logo.png"
        Height="740" Width="1180" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B1015"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <!-- ============================================================
         « WilcoATC — Ice » : reprise fidèle de la maquette Claude Design
         (WilcoATC.dc.html). Coquille à rail de navigation (RAD/FRQ/LOG/CFG),
         palette encre + cyan. Les 4 écrans partagent un seul rail ; les données
         réelles (radio, fréquences, journal, connexion, réglages) sont branchées
         sur le MainViewModel — seuls les éléments sans équivalent backend
         (sessions passées, collationnements, accents) restent décoratifs.
         ============================================================ -->

    <Window.Resources>

        <!-- ===================== Palette « Ice » ===================== -->
        <SolidColorBrush x:Key="DcInk0"          Color="#0B1015"/>  <!-- fond écran -->
        <SolidColorBrush x:Key="DcInk1"          Color="#101820"/>  <!-- rail, barres, panneaux -->
        <SolidColorBrush x:Key="DcInk1b"         Color="#0D141A"/>  <!-- barre sessions / bulle pilote -->
        <SolidColorBrush x:Key="DcLine"          Color="#1E2A33"/>
        <SolidColorBrush x:Key="DcLine2"         Color="#18222A"/>
        <SolidColorBrush x:Key="DcLine3"         Color="#24343F"/>
        <SolidColorBrush x:Key="DcCyan"          Color="#6CC3E8"/>
        <SolidColorBrush x:Key="DcCyanDim"       Color="#4D7A8C"/>
        <SolidColorBrush x:Key="DcCyanBorder"    Color="#2C6076"/>
        <SolidColorBrush x:Key="DcCyanSoftBg"    Color="#0F1E26"/>
        <SolidColorBrush x:Key="DcCyanSoftLine"  Color="#1F3D4B"/>
        <SolidColorBrush x:Key="DcChipCyan"      Color="#173039"/>  <!-- surlignage jetons -->
        <SolidColorBrush x:Key="DcTextHi"        Color="#E6EEF2"/>
        <SolidColorBrush x:Key="DcTextMid"       Color="#DBE6EC"/>
        <SolidColorBrush x:Key="DcTextDim"       Color="#9FB2BC"/>
        <SolidColorBrush x:Key="DcTextMut"       Color="#6B7D87"/>
        <SolidColorBrush x:Key="DcTextFaint"     Color="#47585F"/>
        <SolidColorBrush x:Key="DcTextFaint2"    Color="#3A4A54"/>
        <SolidColorBrush x:Key="DcOrange"        Color="#D8804A"/>
        <SolidColorBrush x:Key="DcOrangeBg"      Color="#1A1512"/>
        <SolidColorBrush x:Key="DcOrangeLine"    Color="#43301F"/>
        <SolidColorBrush x:Key="DcDot"           Color="#2B3A45"/>
        <SolidColorBrush x:Key="DcHover"         Color="#131C24"/>

        <!-- Petit intitulé mono (« FRÉQUENCE ACTIVE », « AU SOL »…). -->
        <Style x:Key="DcKicker" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
        </Style>

        <!-- ===================== Pilule de navigation (rail) ===================== -->
        <Style x:Key="NavPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="50" CornerRadius="9" Padding="0,9"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DcHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource DcTextDim}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16232C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcLine3}"/>
                                <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icône de la barre de navigation : trait fin qui reprend la couleur (Foreground)
             du RadioButton parent, donc cyan quand actif, gris sinon (via les triggers du gabarit). -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ===================== Interrupteur « Ice » ===================== -->
        <Style x:Key="DcSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                                Background="#1C262D" BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource DcTextMut}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource DcCyanBorder}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                                <Setter TargetName="Knob" Property="Background" Value="{StaticResource DcCyan}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ mono discret (recherche OACI, valeurs affichées). -->
        <Style x:Key="DcMonoBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Ligne de transcription (journal ATC) =====================
             Partagée par l'écran RAD (bulles) et LOG. Le tag et la bulle changent
             de couleur selon la nature (ATC / pilote / système…). -->
        <DataTemplate x:Key="TranscriptRow" DataType="{x:Type vm:LogEntryViewModel}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,2,12,0">
                    <TextBlock x:Name="Tag" Text="SYS" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource DcTextMut}"/>
                    <TextBlock Text="{Binding Time}" HorizontalAlignment="Right" Margin="0,3,0,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource DcTextFaint2}"/>
                </StackPanel>
                <Border x:Name="Bubble" Grid.Column="1" CornerRadius="11,11,11,3"
                        Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                        BorderThickness="1" Padding="14,11">
                    <TextBlock x:Name="Msg" Text="{Binding Text}" TextWrapping="Wrap"
                               FontSize="13.5" LineHeight="20"
                               Foreground="{StaticResource DcTextMid}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Atc">
                    <Setter TargetName="Tag" Property="Text" Value="ATC"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcCyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pilot">
                    <Setter TargetName="Tag" Property="Text" Value="VOUS"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcTextDim}"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource DcInk1b}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource DcLine2}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource DcTextDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Refused">
                    <Setter TargetName="Tag" Property="Text" Value="ATC"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcOrange}"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource DcOrangeBg}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource DcOrangeLine}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource DcTextDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Copilot">
                    <Setter TargetName="Tag" Property="Text" Value="COPI"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcCyanDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Chatter">
                    <Setter TargetName="Tag" Property="Text" Value="RADIO"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcTextMut}"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource DcInk1b}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource DcLine2}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource DcTextMut}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Transmit">
                    <Setter TargetName="Tag" Property="Text" Value="TX"/>
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource DcOrange}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Change">
                    <Setter TargetName="Tag" Property="Text" Value="COM"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Initial">
                    <Setter TargetName="Tag" Property="Text" Value="COM"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================== Ligne de fréquence (écran FRQ) ===================== -->
        <DataTemplate x:Key="FreqRow" DataType="{x:Type vm:AirportFrequencyViewModel}">
            <Border x:Name="Row" Margin="0,0,0,6" CornerRadius="10" Padding="13,11"
                    Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Name" Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                               FontSize="13.5" Foreground="{StaticResource DcTextMid}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Freq" Grid.Column="1" Text="{Binding Frequency}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="15"
                               Foreground="{StaticResource DcTextDim}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTuned}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource DcCyanSoftBg}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource DcTextHi}"/>
                    <Setter TargetName="Freq" Property="Foreground" Value="{StaticResource DcCyan}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Groupe de fréquences (une catégorie : GROUND, TOWER…), rangé en colonnes. -->
        <DataTemplate x:Key="FreqGroup" DataType="{x:Type vm:FrequencyGroupViewModel}">
            <StackPanel Width="452" Margin="0,0,26,20">
                <TextBlock Text="{Binding Header}" Style="{StaticResource DcKicker}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FreqRow}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Champ de saisie du formulaire de signalement. -->
        <Style x:Key="DcReportInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="Background" Value="#16232C"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcLine3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Écran CFG : briques communes =====================
             Tous les réglages de l'application vivent maintenant dans cet écran (il n'y a
             plus de fenêtre « Réglages avancés »). Ces quelques styles évitent de recopier
             le même gabarit de carte, de ligne et de bouton une centaine de fois. -->

        <Style x:Key="DcCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource DcInk1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Intitulé d'une ligne de réglage. -->
        <Style x:Key="DcRowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMid}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Aide sous l'intitulé (une phrase, jamais un paragraphe si on peut l'éviter). -->
        <Style x:Key="DcRowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <!-- Séparateur entre deux lignes d'une même carte. -->
        <Style x:Key="DcSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource DcLine2}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <!-- Valeur affichée en pastille (indicatif, touche PTT…). -->
        <Style x:Key="DcChipValue" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Background" Value="#16232C"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcLine3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DcChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Bouton secondaire (la grande majorité : ouvrir un dossier, rafraîchir…). -->
        <Style x:Key="DcBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextDim}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="13,9" Background="#16232C"
                                BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal (téléchargements : la seule action qu'on veut voir de loin). -->
        <Style x:Key="DcBtnPrimary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#06131A"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="15,9" Background="{StaticResource DcCyan}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8AD3F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petit champ de saisie (vitesses V, délais, fréquence Centre…). -->
        <Style x:Key="DcInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="Background" Value="#16232C"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcLine3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Vue d'ensemble des réglages =====================
             Lignes « intitulé … valeur » : on lit son installation d'un coup d'œil sans
             ouvrir une seule section. -->

        <Style x:Key="DcOvKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,130,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DcOvValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <!-- La valeur tronquée reste lisible au survol (chemins, noms de périphériques). -->
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Valeur d'un interrupteur : Tag porte le booléen, le style écrit ON / OFF. -->
        <Style x:Key="DcOvState" TargetType="TextBlock" BasedOn="{StaticResource DcOvValue}">
            <Setter Property="Text" Value="{DynamicResource S.Cfg.Off}"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextFaint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="{DynamicResource S.Cfg.On}"/>
                    <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Badge d'état d'une fonction (EXPÉRIMENTAL / BIENTÔT). -->
        <Style x:Key="DcBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource DcCyanSoftBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DcBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
        </Style>

        <!-- Bascule « manquante / incorrecte » : Tag = bool de sélection. -->
        <ControlTemplate x:Key="SegPill" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Padding="0,10" BorderThickness="1" Background="Transparent"
                    BorderBrush="{StaticResource DcLine3}" TextElement.Foreground="{StaticResource DcTextDim}">
                <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DcCyanSoftBg}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{StaticResource DcCyan}"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding TestTransmissionCommand}"/>
    </Window.InputBindings>

    <!-- ===================== Coquille ===================== -->
    <Grid>
        <!-- Contenu applicatif : flouté tant qu'aucun vol n'est en cours. -->
        <Grid x:Name="AppRoot">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowLaunchVeil}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- Modèles manquants : même traitement. Le flou dit sans un mot que
                             ce qu'il y a derrière n'est pas utilisable pour l'instant. -->
                        <DataTrigger Binding="{Binding ShowRequirements}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="18" KernelType="Gaussian"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Rail de navigation ===================== -->
            <Border Grid.Column="0" Background="{StaticResource DcInk1}"
                    BorderBrush="{StaticResource DcLine}" BorderThickness="0,0,1,0">
                <Grid Margin="0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo de l'application (recadré pour remplir la pastille). -->
                    <Border Grid.Row="0" Width="34" Height="34" CornerRadius="9"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"
                                        Viewbox="0.15,0.15,0.7,0.7"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <RadioButton x:Name="NavRad" GroupName="nav" Style="{StaticResource NavPill}"
                                     ToolTip="Radio" IsChecked="True">
                            <!-- micro -->
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M12 3 A3 3 0 0 1 15 6 L15 11 A3 3 0 0 1 9 11 L9 6 A3 3 0 0 1 12 3 Z
                                        M7 11 A5 5 0 0 0 17 11 M12 16 L12 20 M9 20 L15 20"/>
                        </RadioButton>
                        <RadioButton x:Name="NavFrq" GroupName="nav" Style="{StaticResource NavPill}" ToolTip="Frequencies">
                            <!-- barres de signal -->
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M4 14 L4 18 M8 10 L8 18 M12 6 L12 18 M16 10 L16 18 M20 14 L20 18"/>
                        </RadioButton>
                        <RadioButton x:Name="NavLog" GroupName="nav" Style="{StaticResource NavPill}" ToolTip="Log">
                            <!-- liste -->
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M5 7 L19 7 M5 12 L19 12 M5 17 L13 17"/>
                        </RadioButton>
                    </StackPanel>

                    <RadioButton x:Name="NavCfg" Grid.Row="3" GroupName="nav" Style="{StaticResource NavPill}"
                                 HorizontalAlignment="Center" Margin="0" ToolTip="Settings">
                        <!-- curseurs (réglages) -->
                        <Path Style="{StaticResource NavIcon}"
                              Data="M4 8 L7.4 8 M12.6 8 A2.6 2.6 0 1 1 7.4 8 A2.6 2.6 0 1 1 12.6 8 Z M12.6 8 L20 8
                                    M4 16 L12.4 16 M17.6 16 A2.6 2.6 0 1 1 12.4 16 A2.6 2.6 0 1 1 17.6 16 Z M17.6 16 L20 16"/>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- ===================== Contenu (4 écrans superposés) ===================== -->
            <Grid Grid.Column="1" Background="{StaticResource DcInk0}">

                <!-- ==================================================== RAD -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavRad, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête vol + connexion -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource DcLine2}" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FlightPlanCallsign}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="16" Foreground="{StaticResource DcTextHi}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FlightPlanAircraft}" FontSize="13" Margin="18,0,0,0"
                                           Foreground="{StaticResource DcTextMut}" VerticalAlignment="Center"/>
                                <TextBlock Text="·" FontSize="13" Margin="8,0" Foreground="{StaticResource DcTextFaint}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FlightPlanRoute}" FontSize="13"
                                           Foreground="{StaticResource DcTextMut}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Puce connexion (état réel), calée en haut à droite. -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8"
                                    Padding="12,6" Background="{StaticResource DcInk1}"
                                    BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DcTextMut}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource DcCyan}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource S.Conn.Off}"/>
                                                <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource S.Conn.On}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Corps : radio à gauche, journal à droite -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Background="{StaticResource DcLine2}"/>

                        <!-- === Colonne gauche : parler à l'ATC === -->
                        <Grid Grid.Column="0" Margin="26,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                <Grid Width="168" Height="168" HorizontalAlignment="Center">
                                    <!-- À l'écoute -->
                                    <Border CornerRadius="84" BorderBrush="{StaticResource DcCyanBorder}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4"
                                                                             RadiusX="0.6" RadiusY="0.6">
                                                            <GradientStop Color="#14313D" Offset="0"/>
                                                            <GradientStop Color="#0D1A21" Offset="1"/>
                                                        </RadialGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26"
                                                        VerticalAlignment="Bottom">
                                                <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="2,0"
                                                           VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                                <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="2,0"
                                                           VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                                <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Margin="2,0"
                                                           VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                                <Rectangle Width="4" Height="26" RadiusX="2" RadiusY="2" Margin="2,0"
                                                           VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                                <Rectangle Width="4" Height="12" RadiusX="2" RadiusY="2" Margin="2,0"
                                                           VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource S.Rad.Listening}" Margin="0,9,0,0" HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource DcCyan}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Micro coupé -->
                                    <Border CornerRadius="84" Background="{StaticResource DcInk1}"
                                            BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="15" Height="25" CornerRadius="8" HorizontalAlignment="Center"
                                                    Background="{StaticResource DcTextMut}"/>
                                            <TextBlock Text="{DynamicResource S.Rad.MicOff}" Margin="0,9,0,0" HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="#7F8F99"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{DynamicResource S.Rad.Talk}" Margin="0,18,0,0" HorizontalAlignment="Center"
                                           FontSize="19" Foreground="{StaticResource DcTextHi}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,11,0,0">
                                    <!-- PTT : maintenir pour parler (même boucle que l'ancien micro). -->
                                    <Border x:Name="PttButton" CornerRadius="8" Padding="13,8" Cursor="Hand"
                                            Background="#16232C" BorderBrush="{StaticResource DcLine3}" BorderThickness="1"
                                            PreviewMouseLeftButtonDown="PttButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="PttButton_PreviewMouseLeftButtonUp"
                                            MouseLeave="PttButton_MouseLeave">
                                        <TextBlock Text="{DynamicResource S.Rad.PttHold}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" Foreground="{StaticResource DcTextDim}"/>
                                    </Border>
                                    <!-- Mains libres : bascule micro ouvert (ToggleListenCommand). -->
                                    <Button Command="{Binding ToggleListenCommand}" IsEnabled="{Binding SpeechAvailable}"
                                            Margin="8,0,0,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="8" Padding="13,8"
                                                        Background="Transparent" BorderBrush="{StaticResource DcLine}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{DynamicResource S.Rad.HandsFree}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11" Foreground="{StaticResource DcTextMut}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcLine3}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Fréquence active (radio réelle COM 1). -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{DynamicResource S.Rad.ActiveFreq}" Style="{StaticResource DcKicker}" Margin="0,0,0,10"/>
                                <Border CornerRadius="11" Background="{StaticResource DcInk1}"
                                        BorderBrush="{StaticResource DcLine3}" BorderThickness="1" Padding="17,15">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Com1.Station}" FontSize="13"
                                                       Foreground="{StaticResource DcTextDim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Com1.Title}" Margin="0,4,0,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource DcTextMut}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Com1.Active}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="25" Foreground="{StaticResource DcCyan}"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="11" BorderBrush="{StaticResource DcLine}" BorderThickness="1"
                                        Padding="17,12" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource S.Rad.NextStandby}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource DcTextMut}"/>
                                        <TextBlock Text="{Binding Com1.Standby}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="16" Foreground="{StaticResource DcTextDim}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- === Colonne droite : journal ATC (Log réel) === -->
                        <Grid Grid.Column="2" Margin="26,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource S.Rad.AtcLog}" Style="{StaticResource DcKicker}"/>
                                <TextBlock Text="{Binding Com1.Active}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{StaticResource DcTextFaint2}"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource TranscriptRow}"/>
                                </ScrollViewer>
                                <!-- Aucun échange encore : message d'attente centré. -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Log.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource S.Rad.NoFlightTitle}" HorizontalAlignment="Center"
                                               FontSize="14.5" Foreground="{StaticResource DcTextDim}"/>
                                    <TextBlock Text="{DynamicResource S.Rad.NoFlightBody}"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="300" Margin="0,7,0,0" FontSize="12.5"
                                               Foreground="{StaticResource DcTextMut}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================================================== FRQ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavFrq, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête recherche + raccourcis -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource DcLine2}" BorderThickness="0,0,0,1"
                            Padding="30,24,30,18">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource S.Frq.Title}" FontSize="20" Foreground="{StaticResource DcTextHi}"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" MinWidth="300" CornerRadius="9"
                                        Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine3}"
                                        BorderThickness="1" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⌕" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13" Foreground="{StaticResource DcCyan}" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource DcMonoBox}" MaxLength="4"
                                                 CharacterCasing="Upper"
                                                 Text="{Binding AirportSearchText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SearchAirportCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border CornerRadius="8" Padding="14,8" Background="#16232C"
                                        BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                    <TextBlock Text="{Binding AirportFrequenciesTitle}" FontSize="12"
                                               Foreground="{StaticResource DcTextHi}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                </Border>
                                <Border CornerRadius="8" Padding="14,8" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource DcLine}" BorderThickness="1">
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource S.Frq.Following}"/>
                                                <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAirportPinned}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource S.Frq.Pinned}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Command="{Binding FollowNearestAirportCommand}" Cursor="Hand" Margin="8,0,0,0"
                                        Visibility="{Binding IsAirportPinned, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="14,8"
                                                    BorderBrush="{StaticResource DcLine}" BorderThickness="1"
                                                    Background="Transparent">
                                                <TextBlock Text="{DynamicResource S.Frq.BackNearest}" FontSize="12"
                                                           Foreground="{StaticResource DcTextMut}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding AirportSearchStatus}" Foreground="{StaticResource DcOrange}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Corps FRQ -->
                    <Grid Grid.Row="1" Margin="30,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Bandeau « en cours d'écoute » (COM 1 réel). -->
                        <Border Grid.Row="0" CornerRadius="12" Background="{StaticResource DcCyanSoftBg}"
                                BorderBrush="{StaticResource DcCyanSoftLine}" BorderThickness="1" Padding="20,18"
                                Margin="0,0,0,20">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Frq.NowListening}" Style="{StaticResource DcKicker}"
                                               Foreground="{StaticResource DcCyan}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Com1.Station}" FontSize="15"
                                               Foreground="{StaticResource DcTextHi}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Com1.Active}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" FontSize="30"
                                               Foreground="{StaticResource DcCyan}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock Text="STANDBY " FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource DcCyanDim}"/>
                                        <TextBlock Text="{Binding Com1.Standby}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10" Foreground="{StaticResource DcCyanDim}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Fréquences du terrain (données réelles rangées par catégorie). -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding AirportFrequencyGroups}"
                                              Visibility="{Binding HasAirportFrequencies, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="FreqGroup"/>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AirportFrequenciesEmpty}" Foreground="{StaticResource DcTextMut}"
                                           FontSize="13.5" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAirportFrequencies}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource DcTextFaint}" Text="{DynamicResource S.Frq.Hint}"/>
                            <Button Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                    Command="{Binding OpenReportCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,7" Background="#16232C"
                                                BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                            <TextBlock Text="{DynamicResource S.Rep.Button}" FontSize="12"
                                                       Foreground="{StaticResource DcTextDim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================================================== LOG -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavLog, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Barre sessions -->
                    <Border Grid.Column="0" Background="{StaticResource DcInk1b}"
                            BorderBrush="{StaticResource DcLine2}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource S.Log.Sessions}" Style="{StaticResource DcKicker}" Margin="18,20,0,14"/>
                            <StackPanel Grid.Row="1" Margin="12,0">
                                <!-- Session en cours (indicatif/route réels). -->
                                <Border CornerRadius="10" Background="{StaticResource DcCyanSoftBg}"
                                        BorderBrush="{StaticResource DcCyanBorder}" BorderThickness="1" Padding="14,13"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding FlightPlanCallsign}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="13" Foreground="{StaticResource DcTextHi}"/>
                                            <TextBlock Text="{DynamicResource S.Log.InProgress}" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource DcCyan}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding FlightPlanRoute}" Margin="0,5,0,0" FontSize="12"
                                                   Foreground="{StaticResource DcTextDim}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Sessions passées : pas d'historique persistant côté backend (décoratif). -->
                                <Border CornerRadius="10" Padding="14,13" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="BAW117" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       Foreground="{StaticResource DcTextDim}"/>
                                            <TextBlock Text="24 JUL" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource DcTextFaint}"/>
                                        </Grid>
                                        <TextBlock Text="EGLL → KJFK · B789" Margin="0,5,0,0" FontSize="12"
                                                   Foreground="{StaticResource DcTextMut}"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="14,13">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="DLH8QT" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       Foreground="{StaticResource DcTextDim}"/>
                                            <TextBlock Text="22 JUL" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource DcTextFaint}"/>
                                        </Grid>
                                        <TextBlock Text="EDDM → LSZH · A320" Margin="0,5,0,0" FontSize="12"
                                                   Foreground="{StaticResource DcTextMut}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Stats de session (échanges = journal réel). -->
                            <StackPanel Grid.Row="2" Margin="18,16" >
                                <TextBlock Text="{DynamicResource S.Log.ThisSession}" Style="{StaticResource DcKicker}" Margin="0,0,0,9"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource S.Log.Exchanges}" FontSize="12" Foreground="{StaticResource DcTextDim}"/>
                                    <TextBlock Text="{Binding Log.Count}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource DcTextMid}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{DynamicResource S.Log.Readbacks}" FontSize="12" Foreground="{StaticResource DcTextDim}"/>
                                    <TextBlock Text="OK" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource DcCyan}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Transcription (journal réel) -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource DcLine2}" BorderThickness="0,0,0,1"
                                Padding="26,20,26,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FlightPlanCallsign}" FontSize="18"
                                           Foreground="{StaticResource DcTextHi}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FlightPlanRoute}" FontSize="13" Margin="14,0,0,0"
                                           Foreground="{StaticResource DcTextMut}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" CornerRadius="8" Padding="12,7" Background="#16232C"
                                        BorderBrush="{StaticResource DcLine3}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Log.All}" FontSize="11" Foreground="{StaticResource DcTextHi}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,14">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource TranscriptRow}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==================================================== CFG -->
                <ScrollViewer x:Name="CfgScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=NavCfg, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="32,26">
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="{DynamicResource S.Cfg.Title}" FontSize="20" Foreground="{StaticResource DcTextHi}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="8" Padding="12,6" Background="{StaticResource DcInk1}"
                                        BorderBrush="{StaticResource DcLine3}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DcTextMut}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource DcCyan}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource S.Conn.Off}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource DcTextMut}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource S.Conn.On}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- Sélecteur de section : « Vue d'ensemble » à l'arrivée, puis
                                     chaque section REMPLACE le contenu (une seule à l'écran). -->
                                <ComboBox x:Name="CfgSection" Margin="12,0,0,0" MinWidth="240"
                                          SelectedIndex="0" SelectionChanged="OnCfgSectionChanged">
                                    <ComboBoxItem Tag="overview"  Content="{DynamicResource S.Cfg.Overview}"/>
                                    <ComboBoxItem Tag="audio"     Content="{DynamicResource S.Cfg.Audio}"/>
                                    <ComboBoxItem Tag="voice"     Content="{DynamicResource S.Cfg.Voice}"/>
                                    <ComboBoxItem Tag="mic"       Content="{DynamicResource S.Cfg.Sec.Mic}"/>
                                    <ComboBoxItem Tag="atc"       Content="{DynamicResource S.Cfg.Sec.Atc}"/>
                                    <ComboBoxItem Tag="immersion" Content="{DynamicResource S.Cfg.Sec.Immersion}"/>
                                    <ComboBoxItem Tag="handoffs"  Content="{DynamicResource S.Cfg.Sec.Handoffs}"/>
                                    <ComboBoxItem Tag="flight"    Content="{DynamicResource S.Cfg.Flight}"/>
                                    <ComboBoxItem Tag="language"  Content="{DynamicResource S.Cfg.Sec.Interface}"/>
                                    <ComboBoxItem Tag="freqdata"  Content="{DynamicResource S.Cfg.FreqData}"/>
                                    <ComboBoxItem Tag="diag"      Content="{DynamicResource S.Cfg.Sec.Diag}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Plus de bouton « Enregistrer » : tout s'applique et se sauvegarde seul. -->
                        <TextBlock Text="{DynamicResource S.Cfg.Autosave}" FontSize="12" Margin="0,-14,0,22"
                                   Foreground="{StaticResource DcTextMut}"/>

                        <!-- Une seule section visible à la fois : le sélecteur ci-dessus décide
                             laquelle, la vue d'ensemble tenant lieu de page d'accueil. -->
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                                <!-- ===== VUE D'ENSEMBLE ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=overview}">
                                    <TextBlock Text="{DynamicResource S.Cfg.PickSection}" Style="{StaticResource DcRowHint}"
                                               Margin="0,0,0,18" FontSize="12.5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Son : ce qui entre et ce qui sort. -->
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DcCard}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Cfg.Audio}" Style="{StaticResource DcKicker}"
                                                           Margin="0,0,0,14"/>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Output}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SelectedDevice.Name}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Mic}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SelectedInputDevice.Name}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Ov.Voice}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SherpaVoiceName}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Speed}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SherpaSpeed, StringFormat={}{0:0.0}×}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Parler à l'ATC : ce qu'il faut pour être entendu. -->
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DcCard}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Mic}" Style="{StaticResource DcKicker}"
                                                           Margin="0,0,0,14"/>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Ptt}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.PttKeyDisplay}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Ov.Joystick}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.PttJoystickDisplay}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Mic.Model}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SpeechModelStatus}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.TestTx}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}" Text="F1 · CTRL+ALT+A"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Comportement de l'ATC : ce qui est actif ou non. -->
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DcCard}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Atc}" Style="{StaticResource DcKicker}"
                                                           Margin="0,0,0,14"/>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.AutoContact}"/>
                                                    <TextBlock Style="{StaticResource DcOvState}" Tag="{Binding Settings.AtcAutoContact}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.AtcTab.Atis}"/>
                                                    <TextBlock Style="{StaticResource DcOvState}" Tag="{Binding Settings.AtisEnabled}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.AtcTab.FlightRules}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SelectedFlightRules}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.AtcTab.TestMode}"/>
                                                    <TextBlock Style="{StaticResource DcOvState}" Tag="{Binding TestModeEnabled}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Vol en cours + habillage. -->
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DcCard}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Cfg.Flight}" Style="{StaticResource DcKicker}"
                                                           Margin="0,0,0,14"/>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Callsign}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}" Text="{Binding FlightPlanCallsign}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.AircraftType}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}" Text="{Binding FlightPlanAircraft}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.SimbriefImport}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}" Text="{Binding Settings.SimBriefUsername}"/>
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <TextBlock Style="{StaticResource DcOvKey}" Text="{DynamicResource S.Cfg.Language}"/>
                                                    <TextBlock Style="{StaticResource DcOvValue}"
                                                               Text="{Binding Settings.SelectedAppLanguage.DisplayName}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- ===== AUDIO & EFFET RADIO ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=audio}">
                                <TextBlock Text="{DynamicResource S.Cfg.Audio}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.Output}"/>
                                                <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.OutputHint}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" MinWidth="150" MaxWidth="210" DisplayMemberPath="Name"
                                                      ItemsSource="{Binding Settings.OutputDevices}"
                                                      SelectedItem="{Binding Settings.SelectedDevice}"/>
                                        </Grid>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Audio.RadioEffect}"/>
                                        <Grid Margin="0,12,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                       Text="{DynamicResource S.Audio.BandPass}" VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.RadioBandPass}"/>
                                        </Grid>
                                        <!-- Le souffle de fond a été retiré : voir RadioDsp.Apply.
                                             Un interrupteur qui ne commande plus rien est pire
                                             qu'une option absente. -->
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                       Text="{DynamicResource S.Audio.Squelch}" VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.RadioSquelch}"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                       Text="{DynamicResource S.Audio.Saturation}" VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.RadioSaturation}"/>
                                        </Grid>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Audio.Intensity}"/>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{StaticResource DcCyan}"
                                                       Text="{Binding Settings.RadioIntensity, StringFormat={}{0:P0}}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Audio.IntensityHint}"/>
                                        <Slider Minimum="0" Maximum="1" Margin="0,8,0,0" Value="{Binding Settings.RadioIntensity}"/>

                                        <Grid Margin="0,16,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Audio.Volume}"/>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{StaticResource DcCyan}"
                                                       Text="{Binding Settings.RadioVolume, StringFormat={}{0:P0}}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="1" Margin="0,8,0,0" Value="{Binding Settings.RadioVolume}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Échantillons radio réels : ce qui donne le grain d'un vrai poste. -->
                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Radio.Samples}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Radio.SamplesHint}"/>
                                        <Border Background="#16232C" CornerRadius="8" Padding="12,9" Margin="0,10,0,0"
                                                BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                            <TextBlock Text="{Binding Settings.RadioSamplesState}" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                       Foreground="{StaticResource DcCyan}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource S.Radio.OpenFolder}" Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.OpenRadioSamplesFolderCommand}"/>
                                            <Button Content="{DynamicResource S.Radio.Rescan}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.RefreshRadioSamplesCommand}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                   Text="{Binding Settings.RadioSamplesDir}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Radio.BedVolume}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Radio.BedVolumeHint}"/>
                                        <Slider Minimum="0" Maximum="1" Margin="0,8,0,0" Value="{Binding Settings.RadioBedVolume}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== MICRO & PUSH-TO-TALK ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=mic}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Mic}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.Mic}"/>
                                                <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.MicHint}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" MinWidth="150" MaxWidth="210" DisplayMemberPath="Name"
                                                      ItemsSource="{Binding Settings.InputDevices}"
                                                      SelectedItem="{Binding Settings.SelectedInputDevice}"/>
                                        </Grid>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Mic.Model}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{Binding Settings.SpeechModelStatus}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Mic.ModelHint}"/>
                                        <Button Content="{DynamicResource S.Btn.DownloadSttModel}" Margin="0,12,0,0"
                                                Style="{StaticResource DcBtnPrimary}"
                                                Command="{Binding Settings.DownloadSpeechModelCommand}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Ptt.Title}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Ptt.Hint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Style="{StaticResource DcChipValue}" MinWidth="96">
                                                <TextBlock Style="{StaticResource DcChipText}" Text="{Binding Settings.PttKeyDisplay}"/>
                                            </Border>
                                            <Button Content="{DynamicResource S.Ptt.SetKey}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.CapturePttCommand}"/>
                                            <Button Content="{DynamicResource S.Ptt.Clear}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.ClearPttCommand}"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,14,0,0"
                                                   Text="{DynamicResource S.Ptt.Joystick}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Style="{StaticResource DcChipValue}" MinWidth="96">
                                                <TextBlock Style="{StaticResource DcChipText}" Text="{Binding Settings.PttJoystickDisplay}"/>
                                            </Border>
                                            <Button Content="{DynamicResource S.Ptt.SetJoystick}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.CaptureJoystickCommand}"/>
                                            <Button Content="{DynamicResource S.Ptt.Clear}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.ClearJoystickCommand}"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.TestTx}"/>
                                                <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.TestTxHint}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource DcChipValue}">
                                                <TextBlock Style="{StaticResource DcChipText}" Text="F1 · CTRL+ALT+A"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== IMMERSION ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=immersion}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Immersion}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Imm.Copilot}"
                                                           VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource DcBadge}">
                                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{DynamicResource S.Imm.Experimental}"/>
                                                </Border>
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.CopilotEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.CopilotHint}"/>

                                        <Grid Margin="0,14,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                       Text="{DynamicResource S.Imm.Checklists}" VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.CopilotChecklists}"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Imm.CopilotVoice}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.CopilotVoiceHint}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.SherpaVoices}"
                                                  SelectedItem="{Binding Settings.CopilotVoiceName}"/>

                                        <!-- Jeu d'annonces : VFR (aviation légère) ou IFR (ligne). -->
                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Imm.CopilotRules}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.CopilotRulesHint}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.CopilotRulesModes}"
                                                  SelectedItem="{Binding Settings.SelectedCopilotRules}"/>

                                        <StackPanel Visibility="{Binding Settings.ShowCopilotVSpeeds, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Imm.VSpeeds}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.VSpeedsHint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="V1" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.CopilotV1Knots}"/>
                                            <TextBlock Text="VR" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.CopilotVrKnots}"/>
                                            <TextBlock Text="V2" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.CopilotV2Knots}"/>
                                        </StackPanel>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Imm.Chatter}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.ChatterEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.ChatterHint}"/>
                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,14,0,0" FontSize="13.5"
                                                   Text="{DynamicResource S.Imm.ChatterGap}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.ChatterMinGapSeconds}"/>
                                            <TextBlock Text="—" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="10,0"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.ChatterMaxGapSeconds}"/>
                                            <TextBlock Text="s" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Le contrôle s'adresse au trafic RÉEL présent dans le simulateur. -->
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Imm.TrafficAtc}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.TrafficAtcEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.TrafficAtcHint}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Injection : faire NAÎTRE des appareils pilotés par le simulateur. -->
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Imm.Inject}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.TrafficInjectionEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.InjectHint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource S.Imm.InjectCount}" Style="{StaticResource DcKicker}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}" Text="{Binding Settings.TrafficInjectionCount}"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Sons de cabine : livrés plus tard, donc annoncés mais inopérants. -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Imm.Cabin}"
                                                       VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource DcBadge}">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{DynamicResource S.Imm.ComingSoon}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.CabinComingSoonHint}"/>
                                        <StackPanel IsEnabled="False" Opacity="0.45" Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                           Text="{DynamicResource S.Imm.Cabin}" VerticalAlignment="Center"/>
                                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                          IsChecked="{Binding Settings.CabinEnabled}"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Imm.CabinHint}"/>

                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5" Margin="0,14,0,0"
                                                       Text="{DynamicResource S.Imm.CabinPack}"/>
                                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.CabinPacks}"
                                                      SelectedItem="{Binding Settings.SelectedCabinPack}"/>

                                            <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5" Margin="0,14,0,0"
                                                       Text="{DynamicResource S.Audio.Volume}"/>
                                            <Slider Minimum="0" Maximum="1" Margin="0,8,0,0" Value="{Binding Settings.CabinVolume}"/>

                                            <TextBlock Style="{StaticResource DcRowHint}" Margin="0,14,0,0"
                                                       Text="{DynamicResource S.Imm.CabinAddHint}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="{DynamicResource S.Btn.OpenCabinFolder}" Style="{StaticResource DcBtn}"
                                                        Command="{Binding Settings.OpenCabinFolderCommand}"/>
                                                <Button Content="{DynamicResource S.Btn.Refresh}" Style="{StaticResource DcBtn}"
                                                        Margin="10,0,0,0" Command="{Binding Settings.RefreshCabinPacksCommand}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                       Text="{Binding Settings.CabinPacksDir}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== VOIX ATC ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=voice}">
                                <TextBlock Text="{DynamicResource S.Cfg.Voice}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Voice.Engine}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Voice.EngineHint}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.TtsEngines}"
                                                  SelectedItem="{Binding Settings.SelectedTtsEngine}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Voice.Installed}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.SherpaVoices}"
                                                  SelectedItem="{Binding Settings.SherpaVoiceName}"/>

                                        <Grid Margin="0,16,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.Speed}"/>
                                                <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.SpeedHint}"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{StaticResource DcCyan}"
                                                       Text="{Binding Settings.SherpaSpeed, StringFormat={}{0:0.0}×}"/>
                                        </Grid>
                                        <Slider Minimum="0.5" Maximum="2.0" Margin="0,8,0,0"
                                                Value="{Binding Settings.SherpaSpeed}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Voice.AddVoice}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Voice.AddVoiceHint}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.CatalogVoices}"
                                                  SelectedItem="{Binding Settings.SelectedCatalogVoice}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource S.Btn.DownloadVoice}" Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.DownloadVoiceCommand}"/>
                                            <Button Content="{DynamicResource S.Btn.VoicesFolder}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.OpenVoicesFolderCommand}"/>
                                        </StackPanel>
                                        <Button Content="{Binding Settings.DownloadAllSummary}" Margin="0,10,0,0"
                                                Style="{StaticResource DcBtnPrimary}"
                                                Command="{Binding Settings.DownloadAllVoicesCommand}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                   Text="{DynamicResource S.Voice.DownloadAllHint}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{Binding Settings.VoicesDir}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Voice.WindowsVoice}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.Voices}"
                                                  SelectedItem="{Binding Settings.WindowsVoice}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Voice.GoogleVoice}"/>
                                        <ComboBox Margin="0,8,0,0" IsEditable="True" ItemsSource="{Binding Settings.GoogleVoices}"
                                                  Text="{Binding Settings.GoogleVoiceName}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Voice.GoogleKey}"/>
                                        <TextBox Margin="0,8,0,0" Style="{StaticResource DcInput}"
                                                 Text="{Binding Settings.GoogleApiKeyEnvVar}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Essai : c'est ici qu'on juge le moteur, la voix ET le débit choisis. -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource S.Btn.TestVoice}" Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.TestVoiceCommand}"/>
                                            <TextBlock Text="{Binding Settings.VoiceTestStatus}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" FontSize="12" MaxWidth="420"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource DcCyan}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== COMPORTEMENT ATC ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=atc}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Atc}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <!-- Réactivité : la pause recouvre la synthèse, donc la
                                             baisser rend vraiment l'ATC plus vif. -->
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Atc.Delay}"/>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{StaticResource DcCyan}"
                                                       Text="{Binding Settings.AtcResponseDelayMs, StringFormat={}{0:0} ms}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Atc.DelayHint}"/>
                                        <Slider Minimum="0" Maximum="1500" Margin="0,8,0,0"
                                                Value="{Binding Settings.AtcResponseDelayMs}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.AtcTab.AutoContact}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.AtcAutoContact}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.AtcTab.AutoContactHint}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.AtcTab.Atis}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.AtisEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.AtcTab.AtisHint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       Text="{DynamicResource S.AtcTab.AtisGap}"/>
                                            <TextBox Width="66" Style="{StaticResource DcInput}"
                                                     Text="{Binding Settings.AtisRepeatGapSeconds}"/>
                                            <TextBlock Text="s" Style="{StaticResource DcKicker}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.Atc.Readback}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.RequireReadback}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Atc.ReadbackHint}"/>

                                        <!-- Escalade panne radio : sans collationnement exigé,
                                             il n'y a jamais d'appel sans réponse à escalader. -->
                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding Settings.ShowRadioFailureOption, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5" VerticalAlignment="Center"
                                                           Text="{DynamicResource S.Atc.Intercept}"/>
                                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                          IsChecked="{Binding Settings.ReadbackInterception}"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Atc.InterceptHint}"/>

                                            <!-- Interception RÉELLE : un chasseur créé dans le
                                                 simulateur. Seule fonction qui écrit dans le
                                                 monde du simu, donc coupée par défaut. -->
                                            <Grid Margin="0,14,0,0">
                                                <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5" VerticalAlignment="Center"
                                                           Text="{DynamicResource S.Atc.Fighter}"/>
                                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                          IsChecked="{Binding Settings.InterceptorEnabled}"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Atc.FighterHint}"/>

                                            <StackPanel Visibility="{Binding Settings.InterceptorEnabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5" Margin="0,12,0,0"
                                                           Text="{DynamicResource S.Atc.FighterTitle}"/>
                                                <TextBox Margin="0,8,0,0" Style="{StaticResource DcInput}"
                                                         Text="{Binding Settings.InterceptorTitle}"/>

                                                <Grid Margin="0,12,0,0">
                                                    <TextBlock Style="{StaticResource DcRowTitle}" FontSize="13.5"
                                                               Text="{DynamicResource S.Atc.FighterDuration}"/>
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Foreground="{StaticResource DcCyan}"
                                                               Text="{Binding Settings.InterceptorSeconds, StringFormat={}{0:0} s}"/>
                                                </Grid>
                                                <Slider Minimum="15" Maximum="600" Margin="0,8,0,0"
                                                        Value="{Binding Settings.InterceptorSeconds}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.AtcTab.FlightRules}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.AtcTab.FlightRulesHint}"/>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Settings.FlightRulesModes}"
                                                  SelectedItem="{Binding Settings.SelectedFlightRules}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.AtcTab.Gsx}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.GsxIntegrationEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.AtcTab.GsxHint}"/>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <!-- Mode Test : piloté par le MainViewModel (donc par l'AtcController), pour
                                             que le bandeau orange de la fenêtre suive l'interrupteur. -->
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.AtcTab.TestMode}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding TestModeEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.AtcTab.TestModeHint}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== TRANSFERTS / CENTRE ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=handoffs}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Handoffs}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,0,0,14"
                                                   Text="{DynamicResource S.Tr.Subtitle}"/>

                                        <!-- Secteurs ACC : la seule source qui donne une fréquence
                                             Centre hors Amérique du Nord. Téléchargés à la demande,
                                             jamais redistribués (licence de la source). -->
                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Tr.Sectors}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Tr.SectorsHint}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,8,0,0"
                                                   Text="{Binding Settings.EnrouteSectorsStatus}"/>
                                        <Button Content="{DynamicResource S.Tr.SectorsBtn}" Margin="0,10,0,0"
                                                Style="{StaticResource DcBtnPrimary}"
                                                Command="{Binding Settings.DownloadEnrouteSectorsCommand}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,8,0,0"
                                                   Foreground="{StaticResource DcCyan}"
                                                   Text="{Binding Settings.EnrouteProgress}"/>

                                        <Border Style="{StaticResource DcSep}"/>
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.Tr.Vatsim}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.VatsimEnabled}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Tr.VatsimHint}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Tr.CenterName}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Tr.CenterNameHint}"/>
                                        <TextBox Margin="0,8,0,0" Style="{StaticResource DcInput}" Text="{Binding Settings.CenterName}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Margin="0,16,0,0"
                                                   Text="{DynamicResource S.Tr.CenterFreq}"/>
                                        <TextBox Width="140" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                 Style="{StaticResource DcInput}" Text="{Binding Settings.CenterFrequencyMhz}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== VOL & PLAN DE VOL ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=flight}">
                                <TextBlock Text="{DynamicResource S.Cfg.Flight}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.Cfg.Callsign}"/>
                                            <Border Style="{StaticResource DcChipValue}" HorizontalAlignment="Right">
                                                <TextBlock Style="{StaticResource DcChipText}" Text="{Binding FlightPlanCallsign}"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.Cfg.AircraftType}"/>
                                            <Border Style="{StaticResource DcChipValue}" HorizontalAlignment="Right">
                                                <TextBlock Style="{StaticResource DcChipText}" Text="{Binding FlightPlanAircraft}"/>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Start.SimbriefLabel}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Start.Step3Hint}"/>
                                        <TextBox Margin="0,8,0,0" Style="{StaticResource DcInput}"
                                                 Text="{Binding Settings.SimBriefUsername}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource S.Btn.ImportSimbrief}" Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.ImportSimBriefCommand}"/>
                                            <Button Content="{DynamicResource S.Btn.LoadOfp}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.LoadOfpCommand}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                   Text="{Binding Settings.ImportStatus}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== LANGUE DE L'INTERFACE ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=language}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Interface}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.Language}"/>
                                                <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.LanguageHint}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" MinWidth="130" DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding Settings.AvailableLanguages}"
                                                      SelectedItem="{Binding Settings.SelectedAppLanguage}"/>
                                        </Grid>

                                        <Border Style="{StaticResource DcSep}"/>

                                        <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Lang.AddTitle}"/>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Lang.AddHint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource S.Btn.OpenLangFolder}" Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.OpenLanguagesFolderCommand}"/>
                                            <Button Content="{DynamicResource S.Btn.Refresh}" Style="{StaticResource DcBtn}"
                                                    Margin="10,0,0,0" Command="{Binding Settings.RefreshLanguagesCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ===== Données de fréquences : source + corrections validées ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=freqdata}">
                                <TextBlock Text="{DynamicResource S.Cfg.FreqData}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>

                                <!-- Source des fréquences : le simulateur fait toujours foi ;
                                     ceci n'autorise (ou non) que le repli sur le monde réel. -->
                                <Border Style="{StaticResource DcCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource DcRowTitle}" VerticalAlignment="Center"
                                                       Text="{DynamicResource S.Cfg.RealFreq}"/>
                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource DcSwitch}"
                                                      IsChecked="{Binding Settings.UseRealWorldFrequencies}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.RealFreqHint}"/>

                                        <!-- L'avertissement ne s'affiche que quand le repli est actif :
                                             c'est ce mode-là qui peut citer une fréquence absente du jeu. -->
                                        <Border Background="{StaticResource DcOrangeBg}" BorderBrush="{StaticResource DcOrangeLine}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                                Visibility="{Binding Settings.ShowRealFrequencyWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource S.Cfg.RealFreqWarning}" FontSize="12"
                                                       TextWrapping="Wrap" LineHeight="17"
                                                       Foreground="{StaticResource DcOrange}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DcCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Cfg.ImportFreq}"/>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Cfg.ImportFreqHint}"/>
                                            <TextBlock Text="{Binding ImportFreqStatus}" FontSize="12" Margin="0,8,0,0"
                                                       Foreground="{StaticResource DcCyan}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasImportFreqStatus, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource DcBtn}"
                                                Content="{DynamicResource S.Cfg.ImportBtn}"
                                                Command="{Binding ImportFrequenciesCommand}"/>
                                    </Grid>
                                </Border>
                                </StackPanel>

                                <!-- ===== DIAGNOSTIC & ASSISTANT ===== -->
                                <StackPanel Visibility="{Binding SelectedItem.Tag, ElementName=CfgSection,
                                                         Converter={StaticResource EqualsToVis}, ConverterParameter=diag}">
                                <TextBlock Text="{DynamicResource S.Cfg.Sec.Diag}" Style="{StaticResource DcKicker}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DcCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Où trouver le journal quand l'application « ne fait rien ». -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Log.Title}"/>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Log.Hint}"/>
                                            <Button Content="{DynamicResource S.Btn.OpenLogs}" Margin="0,12,0,0"
                                                    Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.OpenLogsFolderCommand}"/>
                                            <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                       Text="{Binding Settings.LogFilePath}"/>
                                        </StackPanel>

                                        <!-- Rejouer l'assistant de premier lancement. -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource DcRowTitle}" Text="{DynamicResource S.Ob.Relaunch}"/>
                                            <TextBlock Style="{StaticResource DcRowHint}" Text="{DynamicResource S.Ob.RelaunchHint}"/>
                                            <Button Content="{DynamicResource S.Ob.RelaunchBtn}" Margin="0,12,0,0"
                                                    Style="{StaticResource DcBtn}"
                                                    Command="{Binding Settings.RestartOnboardingCommand}"/>
                                            <TextBlock Style="{StaticResource DcRowHint}" Margin="0,10,0,0"
                                                       Text="{Binding Settings.OnboardingStatus}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>

                                <!-- Respiration en bas de page : la dernière section ne colle pas au bord. -->
                                <Border Height="8" Background="Transparent"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ===================== Voile « Lancer un vol » ===================== -->
        <Border x:Name="LaunchOverlay" Background="#D40B1015"
                Visibility="{Binding ShowLaunchVeil, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                        Background="{StaticResource DcCyanSoftBg}" BorderBrush="{StaticResource DcCyanBorder}"
                        BorderThickness="1">
                    <TextBlock Text="✈" FontSize="26" Foreground="{StaticResource DcCyan}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource S.Launch.Title}" HorizontalAlignment="Center" Margin="0,20,0,0"
                           FontSize="22" Foreground="{StaticResource DcTextHi}"/>
                <TextBlock Text="{DynamicResource S.Launch.Body}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" Margin="0,10,0,0" FontSize="13.5"
                           Foreground="{StaticResource DcTextMut}"/>
                <Button Command="{Binding OpenOnboardingCommand}" HorizontalAlignment="Center" Margin="0,22,0,0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource DcCyan}" CornerRadius="9" Padding="30,14">
                                <TextBlock Text="{DynamicResource S.Launch.Button}" FontSize="15" FontWeight="Medium"
                                           Foreground="#06131A"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#8AD3F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===================== Assistant intégré (voile plein écran) ===================== -->
        <Border x:Name="OnboardingHost" Background="{StaticResource DcInk0}"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
            <local:OnboardingView x:Name="OnboardingView"/>
        </Border>

        <!-- ===================== Signaler une fréquence (formulaire modal en fenêtre) ===================== -->
        <Border x:Name="ReportOverlay" Background="#D40B1015"
                Visibility="{Binding ShowReport, Converter={StaticResource BoolToVis}}">
            <Border Width="470" CornerRadius="14" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine3}"
                    BorderThickness="1" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Rep.Title}" FontSize="19" Foreground="{StaticResource DcTextHi}"/>
                    <TextBlock Text="{DynamicResource S.Rep.Subtitle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               LineHeight="18" Foreground="{StaticResource DcTextMut}"/>

                    <TextBlock Text="{DynamicResource S.Rep.Discord}" Style="{StaticResource DcKicker}" Margin="0,18,0,7"/>
                    <TextBox Style="{StaticResource DcReportInput}" MaxLength="40"
                             Text="{Binding ReportDiscordUser, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{DynamicResource S.Rep.Airport}" Style="{StaticResource DcKicker}" Margin="0,14,0,7"/>
                    <TextBox Style="{StaticResource DcReportInput}" CharacterCasing="Upper" MaxLength="4"
                             Text="{Binding ReportAirport, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{DynamicResource S.Rep.Freq}" Style="{StaticResource DcKicker}" Margin="0,14,0,7"/>
                    <TextBox Style="{StaticResource DcReportInput}" FontFamily="{StaticResource MonoFont}" MaxLength="12"
                             Text="{Binding ReportFrequency, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding ReportStatus}" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource DcOrange}"
                               Visibility="{Binding HasReportStatus, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Cursor="Hand" Command="{Binding CloseReportCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="16,10" Background="Transparent"
                                            BorderBrush="{StaticResource DcLine3}" BorderThickness="1">
                                        <TextBlock Text="{DynamicResource S.Rep.Cancel}" FontSize="13"
                                                   Foreground="{StaticResource DcTextDim}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Cursor="Hand" Margin="10,0,0,0" Command="{Binding SubmitReportCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="18,10" Background="{StaticResource DcCyan}">
                                        <TextBlock Text="{DynamicResource S.Rep.Send}" FontSize="13" FontWeight="Medium"
                                                   Foreground="#06131A"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#8AD3F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Assistant de PREMIÈRE CONFIGURATION (1re fois uniquement) ===================== -->
        <Border x:Name="SetupHost" Background="{StaticResource DcInk0}"
                Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
            <local:SetupView x:Name="SetupView"/>
        </Border>

        <!-- ===================== Prérequis manquants (voile bloquant) =====================
             EN DERNIER dans le Grid, donc AU-DESSUS de tout le reste : sans voix ni modèle de
             reconnaissance, aucun autre écran n'a de sens, pas même les assistants. -->
        <local:RequirementsGate x:Name="RequirementsGate"
                                Visibility="{Binding ShowRequirements, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
