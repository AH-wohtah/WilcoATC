<UserControl x:Class="WilcoATC.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WilcoATC.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}"
             Background="#0B1015"
             TextOptions.TextFormattingMode="Ideal"
             FontFamily="{StaticResource UiFont}">

    <!-- ============================================================
         Assistant de premier lancement « Ice » (WilcoATC.dc.html, OB1-OB4),
         intégré À LA FENÊTRE PRINCIPALE (plus de fenêtre séparée). L'étape 2
         affiche le vol RÉEL (indicatif / type / route) et permet d'importer
         depuis SimBrief. DataContext = MainViewModel (hérité de la fenêtre).
         ============================================================ -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="DcInk0"        Color="#0B1015"/>
        <SolidColorBrush x:Key="DcInk1"        Color="#101820"/>
        <SolidColorBrush x:Key="DcLine"        Color="#1E2A33"/>
        <SolidColorBrush x:Key="DcLine3"       Color="#24343F"/>
        <SolidColorBrush x:Key="DcCyan"        Color="#6CC3E8"/>
        <SolidColorBrush x:Key="DcCyanDim"     Color="#4D7A8C"/>
        <SolidColorBrush x:Key="DcCyanBorder"  Color="#2C6076"/>
        <SolidColorBrush x:Key="DcCyanSoftBg"  Color="#0F1E26"/>
        <SolidColorBrush x:Key="DcCyanSoftLine" Color="#1F3D4B"/>
        <SolidColorBrush x:Key="DcTextHi"      Color="#E6EEF2"/>
        <SolidColorBrush x:Key="DcTextMid"     Color="#DBE6EC"/>
        <SolidColorBrush x:Key="DcTextDim"     Color="#9FB2BC"/>
        <SolidColorBrush x:Key="DcTextMut"     Color="#7F8F99"/>
        <SolidColorBrush x:Key="DcTextMut2"    Color="#6B7D87"/>
        <SolidColorBrush x:Key="DcTextFaint"   Color="#47585F"/>
        <SolidColorBrush x:Key="DcTextFaint2"  Color="#3A4A54"/>

        <Style x:Key="DcKicker" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut2}"/>
        </Style>

        <Style x:Key="IcePrimary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource DcCyan}" CornerRadius="9" Padding="26,13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#06131A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8AD3F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IceGhost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#16232C" BorderBrush="{StaticResource DcLine3}"
                                BorderThickness="1" CornerRadius="8" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PttKeyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource DcCyanSoftBg}"
                                BorderBrush="{StaticResource DcCyanBorder}" BorderThickness="1" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#123241"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ de saisie « Ice » (pseudo SimBrief). -->
        <Style x:Key="IceInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="Background" Value="#16232C"/>
            <Setter Property="BorderBrush" Value="{StaticResource DcLine3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pilule « à quel moment » : sélectionnable. Tag = IsStartXxx (bool) pilote la sélection. -->
        <ControlTemplate x:Key="PhasePill" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="12,12" BorderThickness="1"
                    Background="Transparent" BorderBrush="{StaticResource DcLine}"
                    TextElement.Foreground="{StaticResource DcTextDim}">
                <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DcCyanSoftBg}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{StaticResource DcCyan}"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Champ éditable SANS cadre (posé dans une carte qui fournit déjà le fond/bord). -->
        <Style x:Key="IceBareInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DcTextHi}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DcCyan}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegDone" TargetType="Border">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/><Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource DcCyanBorder}"/>
        </Style>
        <Style x:Key="SegNow" TargetType="Border" BasedOn="{StaticResource SegDone}">
            <Setter Property="Background" Value="{StaticResource DcCyan}"/>
        </Style>
        <Style x:Key="SegTodo" TargetType="Border" BasedOn="{StaticResource SegDone}">
            <Setter Property="Background" Value="{StaticResource DcLine}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Contenu : un panneau par étape ===================== -->
        <Grid Grid.Row="0">

            <!-- ============ Étape 1 : recherche du simulateur ============ -->
            <StackPanel x:Name="Step1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,34">
                    <Border Style="{StaticResource SegNow}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                </StackPanel>

                <Grid Width="172" Height="172" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource DcCyanBorder}" StrokeThickness="1">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#14313D" Offset="0"/>
                                <GradientStop Color="#0D1A21" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="116" Height="116" Stroke="{StaticResource DcCyanBorder}" StrokeThickness="1"
                             StrokeDashArray="3 3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="SCAN…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource DcCyan}"/>
                </Grid>

                <TextBlock Text="{DynamicResource S.Ob2.S1Title}" HorizontalAlignment="Center" Margin="0,34,0,0"
                           FontSize="26" Foreground="{StaticResource DcTextHi}"/>
                <TextBlock Text="{DynamicResource S.Ob2.S1Body}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           Margin="0,12,0,0" FontSize="15" LineHeight="24" Foreground="{StaticResource DcTextMut}"/>

                <StackPanel Width="420" Margin="0,34,0,0">
                    <!-- Détection SimConnect : état RÉEL de la connexion. -->
                    <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                            BorderThickness="1" Padding="16,13" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DcTextFaint2}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource DcCyan}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource S.Ob2.SimConnect}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource DcTextMid}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource S.Ob2.Waiting}"/>
                                        <Setter Property="Foreground" Value="{StaticResource DcTextMut2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- Session de vol : vrai seulement quand on est AUX COMMANDES (pas au menu). -->
                    <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                            BorderThickness="1" Padding="16,13">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DcTextFaint2}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InFlightSession}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource DcCyan}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource S.Ob2.FlightSession}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource DcTextMid}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource S.Ob2.Waiting}"/>
                                        <Setter Property="Foreground" Value="{StaticResource DcTextMut2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InFlightSession}" Value="True">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="{StaticResource DcCyan}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ============ Étape 2 : le vol (données RÉELLES + SimBrief) ============ -->
            <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegNow}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource S.Ob2.S2Title}" HorizontalAlignment="Center" FontSize="26" Foreground="{StaticResource DcTextHi}"/>
                <TextBlock Text="{DynamicResource S.Ob2.S2Body}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource DcTextMut}"/>

                <StackPanel Width="620" Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource S.Ob2.Callsign}" Style="{StaticResource DcKicker}" Margin="0,0,0,8"/>
                            <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcCyanBorder}"
                                    BorderThickness="1" Padding="16,14">
                                <TextBox Style="{StaticResource IceBareInput}" FontSize="18" CharacterCasing="Upper" MaxLength="8"
                                         Text="{Binding ManualCallsign, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource S.Ob2.AircraftType}" Style="{StaticResource DcKicker}" Margin="0,0,0,8"/>
                            <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                                    BorderThickness="1" Padding="16,14">
                                <TextBox Style="{StaticResource IceBareInput}" FontSize="18" CharacterCasing="Upper" MaxLength="6"
                                         Text="{Binding ManualAircraft, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource S.Ob2.Route}" Style="{StaticResource DcKicker}" Margin="0,14,0,8"/>
                    <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                            BorderThickness="1" Padding="18,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBox Style="{StaticResource IceBareInput}" FontSize="20" Width="86" TextAlignment="Center"
                                         CharacterCasing="Upper" MaxLength="4"
                                         Text="{Binding ManualOrigin, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{DynamicResource S.Ob2.From}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcTextFaint}"/>
                            </StackPanel>
                            <TextBlock Text="→" FontSize="18" Margin="18,0" VerticalAlignment="Top" Padding="0,4,0,0"
                                       Foreground="{StaticResource DcCyan}"/>
                            <StackPanel>
                                <TextBox Style="{StaticResource IceBareInput}" FontSize="20" Width="86" TextAlignment="Center"
                                         CharacterCasing="Upper" MaxLength="4"
                                         Text="{Binding ManualDestination, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{DynamicResource S.Ob2.To}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcTextFaint}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Import SimBrief : renseigne indicatif / route / type au-dessus. -->
                    <TextBlock Text="{DynamicResource S.Start.SimbriefLabel}" Style="{StaticResource DcKicker}" Margin="0,14,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource IceInput}" MinHeight="42" Margin="0,0,10,0"
                                 Text="{Binding Settings.SimBriefUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="{DynamicResource S.Btn.ImportSimbrief}" Style="{StaticResource IceGhost}"
                                Command="{Binding ImportSimBriefCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding ImportStatus}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource DcTextMut2}"
                               Visibility="{Binding HasImportStatus, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{DynamicResource S.Ob2.WhenStart}" Style="{StaticResource DcKicker}" Margin="0,16,0,8"/>
                    <UniformGrid Columns="3">
                        <Button Command="{Binding StartGateCommand}" Cursor="Hand" Margin="0,0,4,0"
                                Template="{StaticResource PhasePill}" Tag="{Binding IsStartGate}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Ob2.AtGate}" HorizontalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="DELIVERY" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcCyanDim}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartTaxiCommand}" Cursor="Hand" Margin="4,0"
                                Template="{StaticResource PhasePill}" Tag="{Binding IsStartTaxi}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Ob2.AtTaxi}" HorizontalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="GROUND" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcCyanDim}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartAirborneCommand}" Cursor="Hand" Margin="4,0,0,0"
                                Template="{StaticResource PhasePill}" Tag="{Binding IsStartAirborne}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Ob2.Airborne}" HorizontalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="CENTER" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcCyanDim}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- ============ Étape 3 : micro & PTT ============ -->
            <StackPanel x:Name="Step3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegNow}"/>
                    <Border Style="{StaticResource SegTodo}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource S.Ob2.S3Title}" HorizontalAlignment="Center" FontSize="26"
                           Foreground="{StaticResource DcTextHi}"/>
                <TextBlock Text="{DynamicResource S.Ob2.S3Body}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                           Margin="0,10,0,0" FontSize="14" LineHeight="22" Foreground="{StaticResource DcTextMut}"/>

                <StackPanel Width="620" Margin="0,24,0,0">
                    <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="{DynamicResource S.Cfg.Mic}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource DcTextMid}"/>
                            <ComboBox x:Name="InputCombo" HorizontalAlignment="Right" MinWidth="200" MaxWidth="280"
                                      DisplayMemberPath="Name"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Ob2.PttKey}" FontSize="14" Foreground="{StaticResource DcTextMid}"/>
                                <TextBlock Text="{DynamicResource S.Ob2.PttKeyHint}" FontSize="12"
                                           Margin="0,3,0,0" Foreground="{StaticResource DcTextMut2}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PttKeyButton}" Click="OnCapturePtt">
                                <TextBlock x:Name="PttKeyText" Text="{DynamicResource S.Ob2.SetKey}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" Foreground="{StaticResource DcCyan}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border CornerRadius="12" Background="{StaticResource DcCyanSoftBg}" BorderBrush="{StaticResource DcCyanBorder}"
                            BorderThickness="1" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Ob2.ReadAloud}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource DcCyanDim}"/>
                            <TextBlock Text="{Binding FirstCallPhrase}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="440" Margin="0,14,0,0"
                                       FontFamily="{StaticResource MonoFont}" FontSize="17" LineHeight="26"
                                       Foreground="{StaticResource DcTextHi}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="30" Margin="0,16,0,0">
                                <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyanBorder}"/>
                                <Rectangle Width="4" Height="20" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                <Rectangle Width="4" Height="26" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                <Rectangle Width="4" Height="12" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyan}"/>
                                <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcCyanBorder}"/>
                                <Rectangle Width="4" Height="8" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Bottom" Fill="{StaticResource DcLine}"/>
                            </StackPanel>

                            <StackPanel x:Name="MicTestPanel" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button x:Name="BtnMicTest" Content="{DynamicResource S.Ob2.TestMic}" Style="{StaticResource IceGhost}"
                                        HorizontalAlignment="Center" Click="OnMicTest"/>
                                <TextBlock x:Name="MicResult" Text="{DynamicResource S.Ob2.MicHint}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                                           Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource DcCyanDim}"/>
                            </StackPanel>

                            <StackPanel x:Name="MicDownloadPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button x:Name="BtnDownloadAsr" Content="{DynamicResource S.Ob2.DownloadModel}"
                                        Style="{StaticResource IceGhost}" HorizontalAlignment="Center" Click="OnDownloadAsr"/>
                                <TextBlock x:Name="MicDownloadState"
                                           Text="{DynamicResource S.Ob2.ModelMissing}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                                           Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource DcCyanDim}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ============ Étape 4 : prêt ============ -->
            <StackPanel x:Name="Step4" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegDone}"/>
                    <Border Style="{StaticResource SegNow}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource S.Ob2.S4Title}" HorizontalAlignment="Center" FontSize="28"
                           Foreground="{StaticResource DcTextHi}"/>
                <TextBlock Text="{DynamicResource S.Ob2.S4Body}" HorizontalAlignment="Center"
                           Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource DcTextMut}"/>

                <StackPanel Width="660" Margin="0,28,0,0">
                    <Border CornerRadius="12" Background="{StaticResource DcCyanSoftBg}" BorderBrush="{StaticResource DcCyanBorder}"
                            BorderThickness="1" Padding="22,20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Ob2.FirstFreq}" Style="{StaticResource DcKicker}"
                                           Foreground="{StaticResource DcCyan}"/>
                                <TextBlock Text="{Binding FirstContactStation}" Margin="0,5,0,0" FontSize="15"
                                           Foreground="{StaticResource DcTextHi}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FirstContactFreq}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="30" Foreground="{StaticResource DcCyan}"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                                BorderThickness="1" Padding="18,16" Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Cfg.Flight}" Style="{StaticResource DcKicker}"/>
                                <TextBlock Text="{Binding FlightPlanRoute}" Margin="0,4,0,0" FontSize="14"
                                           Foreground="{StaticResource DcTextMid}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                                BorderThickness="1" Padding="18,16" Margin="6,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PUSH-TO-TALK" Style="{StaticResource DcKicker}"/>
                                <TextBlock x:Name="PttRecap" Text="{DynamicResource S.Ob2.PttUnset}" Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{StaticResource DcTextMid}"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                                BorderThickness="1" Padding="18,16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Cfg.Voice}" Style="{StaticResource DcKicker}"/>
                                <TextBlock Text="US · 1.0× · strict" Margin="0,4,0,0" FontSize="14" Foreground="{StaticResource DcTextMid}"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                                BorderThickness="1" Padding="18,16" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Ob2.MicLabel}" Style="{StaticResource DcKicker}"/>
                                <TextBlock x:Name="MicRecap" Text="{DynamicResource S.Ob2.DefaultDevice}" Margin="0,4,0,0"
                                           FontSize="14" Foreground="{StaticResource DcTextMid}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border CornerRadius="10" BorderBrush="{StaticResource DcLine3}" BorderThickness="1" Padding="18,15" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource S.Ob2.Tip}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource DcCyan}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                            <TextBlock TextWrapping="Wrap" MaxWidth="560" FontSize="13" LineHeight="21"
                                       Foreground="{StaticResource DcTextMut}" Text="{DynamicResource S.Ob2.TipBody}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- ===================== Pied : lien secondaire + bouton primaire ===================== -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DcLine}" BorderThickness="0,1,0,0" Padding="0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="SkipLink" Text="{DynamicResource S.Ob2.SkipSim}" VerticalAlignment="Center" Cursor="Hand"
                           Margin="0,0,18,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource DcTextMut2}" MouseLeftButtonUp="OnSkipLink">
                    <TextBlock.TextDecorations>
                        <TextDecoration Location="Underline">
                            <TextDecoration.Pen>
                                <Pen Brush="{StaticResource DcTextFaint2}" Thickness="1" DashStyle="{x:Static DashStyles.Dash}"/>
                            </TextDecoration.Pen>
                        </TextDecoration>
                    </TextBlock.TextDecorations>
                </TextBlock>
                <Button x:Name="BtnNext" Content="{DynamicResource S.Ob2.Next}" Style="{StaticResource IcePrimary}" Click="OnNext"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
