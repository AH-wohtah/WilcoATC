<UserControl x:Class="WilcoATC.RequirementsGate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WilcoATC">

    <!--
        BARRIÈRE DE PRÉREQUIS.

        Tant qu'une voix de synthèse ET un modèle de reconnaissance ne sont pas installés,
        l'ATC ne peut pas fonctionner : sans voix il se tairait, sans modèle il n'entendrait
        rien. Auparavant ces deux manques étaient signalés par une ligne de statut — donc, en
        pratique, par rien du tout : l'utilisateur appuyait sur son alternat et n'obtenait
        aucune réaction, sans savoir laquelle des trois causes possibles était la bonne.

        Ce voile règle la question en la rendant IMPOSSIBLE À MANQUER, et surtout ACTIONNABLE :
        chaque manque a son bouton de téléchargement juste à côté de son intitulé.
    -->

    <Grid Background="#C8070B10">
        <Border Width="560" CornerRadius="16" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource DcInk1}"
                BorderBrush="{DynamicResource DcLine3}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="{DynamicResource S.Gate.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource DcTextHi}" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource S.Gate.Intro}" Margin="0,10,0,0" FontSize="13"
                           Foreground="{DynamicResource DcTextMid}" TextWrapping="Wrap" LineHeight="19"/>

                <!-- voix de l'ATC -->
                <Border Margin="0,22,0,0" CornerRadius="10" Padding="16"
                        Background="{DynamicResource DcInk1b}"
                        BorderBrush="{DynamicResource DcLine2}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Gate.Voice}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DcTextHi}"/>
                            <TextBlock x:Name="VoiceStatus" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource DcTextMid}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="VoiceButton" Grid.Column="1" Margin="14,0,0,0" Padding="18,9"
                                VerticalAlignment="Center" Click="OnDownloadVoices" Style="{DynamicResource DcBtnPrimary}"
                                Content="{DynamicResource S.Gate.Download}"/>
                    </Grid>
                </Border>

                <!-- reconnaissance vocale -->
                <Border Margin="0,12,0,0" CornerRadius="10" Padding="16"
                        Background="{DynamicResource DcInk1b}"
                        BorderBrush="{DynamicResource DcLine2}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Gate.Asr}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DcTextHi}"/>
                            <TextBlock x:Name="AsrStatus" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource DcTextMid}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="AsrButton" Grid.Column="1" Margin="14,0,0,0" Padding="18,9"
                                VerticalAlignment="Center" Click="OnDownloadAsr" Style="{DynamicResource DcBtnPrimary}"
                                Content="{DynamicResource S.Gate.Download}"/>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource S.Gate.Note}" Margin="0,18,0,0" FontSize="11.5"
                           Foreground="{DynamicResource DcTextFaint}" TextWrapping="Wrap" LineHeight="17"/>

                <!--
                    SORTIE DE SECOURS, et non un bouton « plus tard » déguisé : elle n'apparaît
                    qu'une fois les deux prérequis satisfaits. Laisser fermer un voile qui
                    protège d'un logiciel inutilisable reviendrait à le supprimer.
                -->
                <Button x:Name="ContinueButton" Margin="0,20,0,0" Padding="20,10"
                        HorizontalAlignment="Right" Click="OnContinue" Style="{DynamicResource DcBtnPrimary}" Visibility="Collapsed"
                        Content="{DynamicResource S.Gate.Continue}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
