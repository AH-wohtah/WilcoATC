<UserControl x:Class="WilcoATC.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0B1015"
             TextOptions.TextFormattingMode="Ideal"
             FontFamily="{StaticResource UiFont}">

    <!-- ============================================================
         Assistant de première configuration (langue, voix, reconnaissance, push-to-talk).
         Une seule fois, au tout premier lancement.
         ============================================================ -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="DcInk1"        Color="#101820"/>
        <SolidColorBrush x:Key="DcLine"        Color="#1E2A33"/>
        <SolidColorBrush x:Key="DcLine3"       Color="#24343F"/>
        <SolidColorBrush x:Key="DcCyan"        Color="#6CC3E8"/>
        <SolidColorBrush x:Key="DcCyanBorder"  Color="#2C6076"/>
        <SolidColorBrush x:Key="DcCyanSoftBg"  Color="#0F1E26"/>
        <SolidColorBrush x:Key="DcTextHi"      Color="#E6EEF2"/>
        <SolidColorBrush x:Key="DcTextMid"     Color="#DBE6EC"/>
        <SolidColorBrush x:Key="DcTextDim"     Color="#9FB2BC"/>
        <SolidColorBrush x:Key="DcTextMut"     Color="#7F8F99"/>
        <SolidColorBrush x:Key="DcTextMut2"    Color="#6B7D87"/>

        <Style x:Key="DcKicker" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut2}"/>
        </Style>

        <Style x:Key="IcePrimary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource DcCyan}" CornerRadius="9" Padding="26,13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#06131A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8AD3F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IceGhost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#16232C" BorderBrush="{StaticResource DcLine3}"
                                BorderThickness="1" CornerRadius="8" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DcCyanBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petit bouton texte (Effacer). -->
        <Style x:Key="IceLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DcTextMut2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,4">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DcTextDim}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">

            <Border Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" Viewbox="0.15,0.15,0.7,0.7"/>
                </Border.Background>
            </Border>
            <TextBlock Text="{DynamicResource S.Setup.Title}" HorizontalAlignment="Center" Margin="0,16,0,0"
                       FontSize="24" Foreground="{StaticResource DcTextHi}"/>
            <TextBlock Text="{DynamicResource S.Setup.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="440" Margin="0,10,0,0" FontSize="13.5" LineHeight="20"
                       Foreground="{StaticResource DcTextMut}"/>

            <!-- ============ Langue ============ -->
            <TextBlock Text="{DynamicResource S.Setup.LangSection}" Style="{StaticResource DcKicker}" Margin="0,28,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                    BorderThickness="1" Padding="18,16">
                <ComboBox HorizontalAlignment="Left" MinWidth="220" DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedAppLanguage}"/>
            </Border>

            <!-- ============ Voix + reconnaissance ============ -->
            <TextBlock Text="{DynamicResource S.Setup.ModelsSection}" Style="{StaticResource DcKicker}" Margin="0,20,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                    BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Setup.ModelsHint}" FontSize="12.5" TextWrapping="Wrap"
                               LineHeight="18" Foreground="{StaticResource DcTextMut}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VoicesStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource DcTextDim}" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="{DynamicResource S.Setup.DlVoices}" Style="{StaticResource IceGhost}"
                                Click="OnDownloadVoices"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DcLine}" Margin="0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AsrStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource DcTextDim}" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="{DynamicResource S.Setup.DlAsr}" Style="{StaticResource IceGhost}"
                                Click="OnDownloadAsr"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Push-to-talk ============ -->
            <TextBlock Text="{DynamicResource S.Setup.PttSection}" Style="{StaticResource DcKicker}" Margin="0,20,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource DcInk1}" BorderBrush="{StaticResource DcLine}"
                    BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Setup.PttHint}" FontSize="12.5" TextWrapping="Wrap"
                               LineHeight="18" Foreground="{StaticResource DcTextMut}"/>

                    <!-- Clavier -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Setup.KeyboardLabel}" FontSize="14" Foreground="{StaticResource DcTextMid}"/>
                            <TextBlock x:Name="KeyDisplay" Text="—" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" Foreground="{StaticResource DcCyan}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource S.Setup.SetKey}" Style="{StaticResource IceGhost}"
                                Click="OnSetKey"/>
                        <Button Grid.Column="2" Content="{DynamicResource S.Setup.Clear}" Style="{StaticResource IceLink}"
                                Margin="6,0,0,0" Click="OnClearKey"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DcLine}" Margin="0,14"/>

                    <!-- Périphérique externe (manette / joystick / throttle) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Setup.DeviceLabel}" FontSize="14" Foreground="{StaticResource DcTextMid}"/>
                            <TextBlock x:Name="ButtonDisplay" Text="—" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" Foreground="{StaticResource DcCyan}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource S.Setup.SetButton}" Style="{StaticResource IceGhost}"
                                Click="OnSetButton"/>
                        <Button Grid.Column="2" Content="{DynamicResource S.Setup.Clear}" Style="{StaticResource IceLink}"
                                Margin="6,0,0,0" Click="OnClearButton"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource S.Setup.Finish}" Style="{StaticResource IcePrimary}"
                    HorizontalAlignment="Center" Margin="0,28,0,0" Click="OnFinish"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
