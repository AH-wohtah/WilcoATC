<Window x:Class="FreqWatch.VoiceDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WilcoATC"
        Height="190" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource S.Dl.Title}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusText" Text="{DynamicResource S.Dl.Preparing}"
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="12" Margin="0,8,0,14"/>
        <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="PercentText" Text="0 %"
                   Foreground="{StaticResource TextDimBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                   Margin="0,8,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
